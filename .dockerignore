# Ignore everything by default
*

# Allow source directories
!server/
!web/
!.gitkeep

# Exclude heavy web dev artifacts (built inside Docker by svelte-builder stage)
web/node_modules/
web/.svelte-kit/
web/build/

# But ignore git and other temporary files
.git
.gitignore
.vscode
.idea
*.log
*.DS_Store

# Ignore local development files
.env
docker-compose.dev.yml
settings.dev.json

# Ignore test files
tests/
