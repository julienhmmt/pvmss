# Ignore everything by default
*

# Allow files and directories
!backend/
!frontend/
!.gitkeep
!go.mod
!go.sum

# Exclude heavy frontend dev artifacts (built inside Docker by svelte-builder stage)
frontend/node_modules/
frontend/.svelte-kit/
frontend/build/

# But ignore git and other temporary files
.git
.gitignore
.vscode
.idea
*.log
*.DS_Store

# Ignore local development files
.env
docker-compose.dev.yml
settings.dev.json

# Ignore test files
tests/
