# Ignore everything by default
*

# Allow source directories
!server/
!web/
!.gitkeep

# Exclude heavy web/server dev artifacts (built inside Docker)
server/pvmss
server/coverage.out
web/node_modules/
web/.svelte-kit/
web/build/
web/coverage/
web/playwright-report/
web/test-results/
web/src/lib/paraglide/
web/project.inlang/*
!web/project.inlang/settings.json

# But ignore git and other temporary files
.git
.gitignore
.vscode
.idea
*.log
*.DS_Store

# Ignore local development files
.env
docker-compose.dev.yml
settings.dev.json

# Ignore test files
tests/
