{
	"name": "pvmss-web",
	"private": true,
	"version": "0.4.0",
	"type": "module",
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync",
		"check": "bunx @inlang/paraglide-js compile --project project.inlang --outdir src/lib/paraglide && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc -p tsconfig.e2e.json --noEmit",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"test:e2e": "bun run build && playwright test",
		"test:e2e:install": "playwright install --with-deps chromium"
	},
	"devDependencies": {
		"@axe-core/playwright": "4.10.2",
		"@eslint/js": "^10.0.1",
		"@inlang/paraglide-js": "2.29.3",
		"@playwright/test": "^1.65.1",
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/kit": "^3.4.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.2",
		"@tailwindcss/vite": "^4.3.5",
		"@types/node": "^26.6.11",
		"@vitest/coverage-v8": "^5.1.2",
		"eslint": "^10.15.0",
		"eslint-plugin-svelte": "^3.24.1",
		"globals": "^17.14.0",
		"happy-dom": "^21.0.4",
		"svelte": "^5.59.2",
		"svelte-check": "^4.7.8",
		"tailwindcss": "^4.3.5",
		"tw-animate-css": "^1.4.0",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.74.0",
		"vite": "^8.4.0",
		"vitest": "^5.1.2"
	},
	"dependencies": {
		"@fontsource-variable/archivo": "^5.3.0",
		"@novnc/novnc": "1.7.0",
		"@xterm/addon-fit": "^0.11.0",
		"@xterm/xterm": "^6.0.0"
	},
	"overrides": {
		"brace-expansion": "^5.0.12",
		"nanoid": "^3.3.20",
		"postcss-selector-parser": "^7.1.7",
		"source-map-js": "^1.2.2"
	},
	"engines": {
		"bun": "1.4.3"
	}
}
