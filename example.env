# ─── Proxmox VE credentials ───────────────────────────────────────────────────
# Required unless PVMSS_OFFLINE=true
PROXMOX_URL="https://ip-or-name:8006/api2/json"
PROXMOX_API_TOKEN_NAME="tokenName@changeMe!value"
PROXMOX_API_TOKEN_VALUE="aaaaaaaa-0000-44aa-1111-aaaaaaaaaaa"
# Set to false ONLY for self-signed labs; mount the Proxmox CA cert for production
PROXMOX_VERIFY_SSL=true

# ─── Secrets (all required, minimum 32 characters) ────────────────────────────
# JWT_SECRET signs /api/v1/ access and refresh tokens.
JWT_SECRET=changeMeWithSomethingElseUniqueMinimum32Chars
# SESSION_SECRET encrypts server-side sessions.
SESSION_SECRET=changeMeWithSomethingElseUniqueMinimum32Chars
# ADMIN_PASSWORD_HASH is a bcrypt hash of the built-in admin password.
# Generate with: htpasswd -bnBC 12 "" <password> | tr -d ':\n'
# Escape every "$" with double "$$" when using a .env file.
ADMIN_PASSWORD_HASH="$$2y$$10$$Ppg7Wl3sNYrmxZmWgcq4reOyznt7AeqMrQucaH4HY.dBrzavhPP1e"

# ─── Database ─────────────────────────────────────────────────────────────────
# Path to the SQLite database file. Must be on a persistent volume.
PVMSS_DB_PATH=/data/pvmss.db

# ─── General ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_OUTPUT=stdout # stdout / file / both
LOG_FILE_PATH=/app/debug.log # If "file" or "both" on LOG_OUTPUT, you need to set this to a valid file path
LOG_FORMAT=console # "console" or "json". If "json", the log will be in JSON format, used for SIEM.
PVMSS_ENV=production # or 'prod', 'development', 'dev'
TZ=Europe/Paris

# ─── Offline mode ─────────────────────────────────────────────────────────────
# Set to true to disable all Proxmox API calls (useful for development/testing).
PVMSS_OFFLINE=false
# If Proxmox is unreachable for 2 minutes, PVMSS will automatically switch to offline mode.
# The app returns to online mode automatically when Proxmox becomes reachable again.

# ─── Frontend dev server (HMR / Vite) ─────────────────────────────────────────
# When accessing the Vite dev server (frontend-dev) through a TLS-terminating
# reverse proxy on a standard port (e.g. OrbStack providing https://frontend-dev.pvmss.orb.local),
# set ORIGIN to the external URL (no port). This makes Vite emit the correct
# asset base and tell the HMR client to connect via wss://... on the proxy's
# port instead of always appending the internal :5173.
# Example (uncomment and adjust in your local .env):
# ORIGIN=https://frontend-dev.pvmss.orb.local
# Then run `task dev` (or `docker compose -f docker-compose.dev.yml up -d`).
# The docker-compose.dev.yml and vite.config.ts consume this to configure
# server.origin and hmr.{host,protocol,clientPort}.