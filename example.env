# Copy to .env and adjust. Every variable below is read by
# server/internal/config/load.go — the server refuses to start if a required
# one is missing or malformed.

# ─── Server (all required) ────────────────────────────────────────────────────
PVMSS_PORT=50000
# SQLite database file. Must be on a persistent volume.
PVMSS_DB_PATH=/data/pvmss.db
# Bind address. Defaults to 127.0.0.1; the Docker image sets 0.0.0.0 so the
# published port works. Only override for bare-metal loopback-only setups.
# PVMSS_HOST=0.0.0.0
# Directory holding the built SvelteKit SPA. Defaults to a path relative to the
# executable; the Docker image sets /app/web/build. Running the binary outside
# Docker (e.g. `cd server && go run ./cmd/pvmss`) needs it set explicitly —
# startup aborts with "web build directory not found" otherwise.
# PVMSS_WEB_DIR=../web/build

# ─── Cluster source (required — no default, on purpose) ───────────────────────
# "fake" serves hardcoded demo data with demo credentials (admin@pve /
# pvmss-admin) and must never be selected by accident. "proxmox" talks to a
# real cluster and requires the three PROXMOX_* variables below.
PVMSS_CLUSTER_SOURCE=fake

# ─── Proxmox VE credentials (required when PVMSS_CLUSTER_SOURCE=proxmox) ──────
PROXMOX_URL="https://ip-or-name:8006/api2/json"
PROXMOX_API_TOKEN_NAME="tokenName@changeMe!value"
PROXMOX_API_TOKEN_VALUE="aaaaaaaa-0000-44aa-1111-aaaaaaaaaaa"

# ─── Secrets ──────────────────────────────────────────────────────────────────
# SESSION_SECRET is required and must be at least 32 bytes.
SESSION_SECRET=changeMeWithSomethingElseUniqueMinimum32Chars
# ADMIN_PASSWORD_HASH is optional; when set it must be a bcrypt hash.
# Generate with: htpasswd -bnBC 12 "" <password> | tr -d ':\n'
# Escape every "$" with double "$$" when using a .env file.
ADMIN_PASSWORD_HASH="$$2y$$10$$Ppg7Wl3sNYrmxZmWgcq4reOyznt7AeqMrQucaH4HY.dBrzavhPP1e"
# Session cookies are marked Secure by default. Set to false only for local
# plain-HTTP development.
# PVMSS_COOKIE_SECURE=true

# ─── Logging (all required) ───────────────────────────────────────────────────
# LOG_LEVEL is matched case-sensitively: debug | info | warn | error
LOG_LEVEL=info
# json for SIEM ingestion, console for human-readable output.
LOG_FORMAT=console
# stdout, stderr, or a writable file path.
LOG_OUTPUT=stdout

# ─── Inventory refresh and paging (optional, defaults shown) ──────────────────
# PVMSS_INVENTORY_REFRESH_INTERVAL=30s
# PVMSS_INVENTORY_MANUAL_REFRESH_MIN_INTERVAL=5s
# PVMSS_INVENTORY_REFRESH_TIMEOUT=15s
# PVMSS_MAX_LIST_PAGE_SIZE=100

# ─── Container runtime ────────────────────────────────────────────────────────
TZ=Europe/Paris
