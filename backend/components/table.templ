package components

type TableColumn struct {
	Key      string
	Header   string
	Class    string
	Sortable bool
}

type TableProps struct {
	ID          string
	Columns     []TableColumn
	Class       string
	Striped     bool
	Hoverable   bool
	Fullwidth   bool
	Bordered    bool
	Narrow      bool
	EmptyText   string
	EmptyIcon   string
}

templ TableHeader(props TableProps) {
	<thead>
		<tr>
			for _, col := range props.Columns {
				<th class={ col.Class }>
					if col.Sortable {
						<span class="is-flex is-align-items-center">
							{ col.Header }
							<span class="icon is-small ml-1">
								<i class="fas fa-sort"></i>
							</span>
						</span>
					} else {
						{ col.Header }
					}
				</th>
			}
		</tr>
	</thead>
}

templ TableWrapper(props TableProps) {
	<div class="table-container">
		<table
			if props.ID != "" {
				id={ props.ID }
			}
			class={
				"table",
				templ.KV("is-striped", props.Striped),
				templ.KV("is-hoverable", props.Hoverable),
				templ.KV("is-fullwidth", props.Fullwidth),
				templ.KV("is-bordered", props.Bordered),
				templ.KV("is-narrow", props.Narrow),
				props.Class,
			}
		>
			@TableHeader(props)
			<tbody>
				{ children... }
			</tbody>
		</table>
	</div>
}

templ TableEmpty(props TableProps, T TranslationFunc) {
	<tr>
		<td colspan={ string(rune(len(props.Columns) + '0')) } class="has-text-centered py-6">
			@EmptyState(EmptyStateProps{
				Icon:        props.EmptyIcon,
				Title:       props.EmptyText,
				Description: T("Common.NoDataAvailable"),
			})
		</td>
	</tr>
}
