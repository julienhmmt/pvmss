package components

type AdminLayoutProps struct {
	Title       string
	Lang        string
	CurrentPath string
	Username    string
	CSRFToken   string
	Content     templ.Component
	T           TranslationFunc
}

type AdminMenuItem struct {
	Href    string
	Icon    string
	Text    string
	Active  bool
}

func AdminMenuItems(currentPath string, T TranslationFunc) []AdminMenuItem {
	items := []AdminMenuItem{
		{Href: "/admin/nodes", Icon: "fas fa-server", Text: T("Admin.Menu.Nodes")},
		{Href: "/admin/storage", Icon: "fas fa-database", Text: T("Admin.Menu.Storage")},
		{Href: "/admin/vms", Icon: "fas fa-desktop", Text: T("Admin.Menu.VMs")},
		{Href: "/admin/userpool", Icon: "fas fa-users", Text: T("Admin.Menu.UserPool")},
		{Href: "/admin/tags", Icon: "fas fa-tags", Text: T("Admin.Menu.Tags")},
		{Href: "/admin/limits", Icon: "fas fa-sliders-h", Text: T("Admin.Menu.Limits")},
		{Href: "/admin/vmbr", Icon: "fas fa-network-wired", Text: T("Admin.Menu.Network")},
		{Href: "/admin/cloudinit", Icon: "fas fa-cloud", Text: T("Admin.Menu.CloudInit")},
		{Href: "/admin/iso", Icon: "fas fa-compact-disc", Text: T("Admin.Menu.ISO")},
		{Href: "/admin/appinfo", Icon: "fas fa-info-circle", Text: T("Admin.Menu.AppInfo")},
	}
	for i := range items {
		if items[i].Href == currentPath {
			items[i].Active = true
		}
	}
	return items
}

templ AdminLayout(props AdminLayoutProps) {
	@Layout(LayoutProps{
		Title:           props.Title,
		Lang:            props.Lang,
		CurrentPath:     props.CurrentPath,
		Content:         adminLayoutContent(props),
		IsAuthenticated: true,
		IsAdmin:         true,
		Username:        props.Username,
		ProxmoxConnected: true,
		CSRFToken:       props.CSRFToken,
		T:               props.T,
	})
}

templ adminLayoutContent(props AdminLayoutProps) {
	<section class="section admin-section">
		<div class="container">
			<div class="columns">
				<div class="column is-3">
					@AdminSidebar(props.CurrentPath, props.T)
				</div>
				<div class="column is-9">
					@props.Content
				</div>
			</div>
		</div>
	</section>
}

templ AdminSidebar(currentPath string, T TranslationFunc) {
	<aside class="menu admin-menu">
		<p class="menu-label">
			<span class="icon-text">
				<span class="icon"><i class="fas fa-cog"></i></span>
				<span>{ T("Admin.Menu.Title") }</span>
			</span>
		</p>
		<ul class="menu-list">
			for _, item := range AdminMenuItems(currentPath, T) {
				<li>
					<a
						href={ templ.SafeURL(item.Href) }
						class={ templ.KV("is-active", item.Active) }
						if item.Active {
							aria-current="page"
						}
					>
						<span class="icon-text">
							<span class="icon"><i class={ item.Icon }></i></span>
							<span>{ item.Text }</span>
						</span>
					</a>
				</li>
			}
		</ul>
	</aside>
}

templ AdminPageHeader(title string, icon string, subtitle string, actions templ.Component) {
	<div class="level mb-5">
		<div class="level-left">
			<div class="level-item">
				<div>
					<h1 class="title is-4">
						<span class="icon-text">
							<span class="icon has-text-primary">
								<i class={ icon }></i>
							</span>
							<span>{ title }</span>
						</span>
					</h1>
					if subtitle != "" {
						<p class="subtitle is-6 has-text-grey">{ subtitle }</p>
					}
				</div>
			</div>
		</div>
		if actions != nil {
			<div class="level-right">
				<div class="level-item">
					@actions
				</div>
			</div>
		}
	</div>
}
