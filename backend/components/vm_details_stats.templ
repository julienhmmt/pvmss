package components

import (
	"fmt"
	"strconv"
)

templ vmDetailsCPUStat(data VMDetailsData, T TranslationFunc) {
	<div class="column is-one-third-tablet is-half-mobile">
		<div id="cpu-stat-card" class="stat-card" style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 12px; padding: 1.5rem; box-shadow: 0 1px 4px rgba(0,0,0,0.04); height: 100%; transition: all 0.15s ease;">
			<div class="is-flex is-align-items-center is-justify-content-space-between mb-4">
				<div class="is-flex is-align-items-center">
					<span class="icon has-text-primary mr-3" style="font-size: 1.25rem;">
						<i class="fas fa-microchip"></i>
					</span>
					<div>
						<div class="has-text-grey-dark is-size-6" style="font-weight: 600;">{ T("VMDetails.Label.CPU") }</div>
						<div class="has-text-grey is-size-7" style="margin-top: 2px;">{ T("VMDetails.CPU.UsageLabel") }</div>
					</div>
				</div>
				<div class="has-text-right">
					<div class="has-text-primary is-size-5" style="font-weight: 600;" data-metric="cpu">
						if data.VM.Status == "running" {
							{ fmt.Sprintf("%.0f%%", data.VM.CPU*100) }
						} else {
							--
						}
					</div>
					<div class="has-text-grey is-size-7" style="margin-top: 2px;">
						{ strconv.Itoa(data.VM.CPUs) } vCPU{ vmDetailsPluralS(data.VM.CPUs) }
					</div>
				</div>
			</div>
			<div style="margin-top: 1.5rem;">
				<div class="has-text-grey-dark" style="font-size: 0.9rem; font-weight: 500;">
					<i class="fas fa-microchip" style="font-size: 0.85rem; opacity: 0.6; margin-right: 6px;"></i>
					{ strconv.Itoa(data.VM.CPUs) } core{ vmDetailsPluralS(data.VM.CPUs) }
					if data.VM.Status == "running" {
						<span class="tag" style="background: rgb(255 136 0 / 12%); color: var(--primary-dark); border: none; font-size: 0.75rem; padding: 0.25rem 0.5rem; line-height: 1.4; margin-left: 0.5rem;">
							{ T("VMDetails.CPU.Active") }
						</span>
					}
				</div>
				if data.VM.Status == "running" {
					<div style="margin-top: 0.75rem;">
						<progress class="progress is-small is-primary" value={ fmt.Sprintf("%.0f", data.VM.CPU*100) } max="100" data-progress="cpu" style="height: 6px; border-radius: 3px;"></progress>
					</div>
				}
			</div>
		</div>
	</div>
}

func vmDetailsPluralS(count int) string {
	if count > 1 {
		return "s"
	}
	return ""
}

templ vmDetailsRAMStat(data VMDetailsData, T TranslationFunc) {
	<div class="column is-one-third-tablet is-half-mobile">
		<div id="ram-stat-card" class="stat-card" style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 12px; padding: 1.5rem; box-shadow: 0 1px 4px rgba(0,0,0,0.04); height: 100%; transition: all 0.15s ease;">
			<div class="is-flex is-align-items-center is-justify-content-space-between mb-4">
				<div class="is-flex is-align-items-center">
					<span class="icon has-text-success mr-3" style="font-size: 1.25rem;">
						<i class="fas fa-memory"></i>
					</span>
					<div>
						<div class="has-text-grey-dark is-size-6" style="font-weight: 600;">{ T("VMDetails.Label.RAM") }</div>
						<div class="has-text-grey is-size-7" style="margin-top: 2px;">{ T("VMDetails.RAM.UsageLabel") }</div>
					</div>
				</div>
				<div class="has-text-right">
					<div class="has-text-success is-size-5" style="font-weight: 600;" data-metric="ram">
						if data.VM.Status == "running" {
							{ data.FormattedMemGB }
						} else {
							--
						}
					</div>
					<div class="has-text-grey is-size-7" style="margin-top: 2px;">
						if data.VM.Status == "running" {
							{ vmDetailsRAMPercent(data) }%
						} else {
							{ T("VMDetails.RAM.Total") }
						}
					</div>
				</div>
			</div>
			<div style="margin-top: 1.5rem;">
				<div class="has-text-grey-dark" style="font-size: 0.9rem; font-weight: 500;">
					<i class="fas fa-memory" style="font-size: 0.85rem; opacity: 0.6; margin-right: 6px;"></i>
					if data.VM.Status == "running" {
						{ data.FormattedMemGB } / { data.FormattedMaxMemGB } { T("VMDetails.RAM.Used") }
						<span class="tag" style="background: rgba(34,197,94,0.08); color: #16a34a; border: none; font-size: 0.75rem; padding: 0.25rem 0.5rem; line-height: 1.4; margin-left: 0.5rem;">
							{ T("VMDetails.RAM.InUse") }
						</span>
					} else {
						{ data.FormattedMaxMemGB } { T("VMDetails.RAM.Total") }
					}
				</div>
				if data.VM.Status == "running" {
					<div style="margin-top: 0.75rem;">
						<progress class="progress is-small is-success" value={ strconv.FormatInt(data.VM.Mem, 10) } max={ strconv.FormatInt(data.VM.MaxMem, 10) } data-progress="ram" style="height: 6px; border-radius: 3px;"></progress>
					</div>
				}
			</div>
		</div>
	</div>
}

templ vmDetailsDiskStat(data VMDetailsData, T TranslationFunc) {
	<div class="column is-one-third-tablet is-half-mobile">
		<div id="disk-stat-card" class="stat-card" style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 12px; padding: 1.5rem; box-shadow: 0 1px 4px rgba(0,0,0,0.04); height: 100%; transition: all 0.15s ease;">
			<div class="is-flex is-align-items-center is-justify-content-space-between mb-4">
				<div class="is-flex is-align-items-center">
					<span class="icon has-text-primary mr-3" style="font-size: 1.25rem;">
						<i class="fas fa-hdd"></i>
					</span>
					<div>
						<div class="has-text-grey-dark is-size-6" style="font-weight: 600;">{ T("VMDetails.Section.Disks") }</div>
						<div class="has-text-grey is-size-7" style="margin-top: 2px;">{ T("VMDetails.Section.DisksDescription") }</div>
					</div>
				</div>
				if len(data.Disks) > 0 {
					<div class="has-text-right">
						<div class="has-text-primary is-size-5" style="font-weight: 600;">{ strconv.Itoa(len(data.Disks)) }</div>
						<div class="has-text-grey is-size-7" style="margin-top: 2px;">{ T("VMDetails.Disks.Total") }: { data.DisksTotalLabel }</div>
					</div>
				}
			</div>
			if len(data.Disks) > 0 {
				<div style="margin-top: 1.5rem;">
					for i, d := range data.Disks {
						@vmDetailsDiskItem(d, i, len(data.Disks))
					}
				</div>
			} else {
				<div style="text-align: center; padding: 2rem 0;">
					<span class="icon has-text-grey-light" style="font-size: 2.5rem;">
						<i class="fas fa-hdd"></i>
					</span>
					<p class="has-text-grey is-size-6" style="margin-top: 1rem;">{ T("VMDetails.Disks.EmptyTitle") }</p>
					<p class="has-text-grey-light is-size-7" style="margin-top: 0.5rem;">{ T("VMDetails.Disks.EmptySubtitle") }</p>
				</div>
			}
		</div>
	</div>
}

templ vmDetailsDiskItem(d DiskInfo, idx int, total int) {
	<div class="disk-item" style={ vmDetailsDiskItemStyle(idx, total) }>
		<div class="is-flex is-align-items-start is-justify-content-between">
			<div class="is-flex" style="gap: 0.75rem; flex: 1; min-width: 0;">
				<span class="has-text-primary" style="font-size: 1.1rem; font-weight: 600; line-height: 1;">
					<i class="fas fa-hdd"></i>
					{ d.Index }
				</span>
				<div class="is-flex" style="gap: 0.5rem; flex-wrap: wrap;">
					if d.Bus != "" {
						<span class="tag" style="background: rgb(255 136 0 / 12%); color: var(--primary-dark); border: none; font-size: 0.75rem; padding: 0.25rem 0.5rem; line-height: 1.4;">
							<span style={ fmt.Sprintf("width: 6px; height: 6px; border-radius: 50%%; background: %s; display: inline-block;", d.Color) }></span>
							{ d.Bus }
						</span>
					}
					if d.Storage != "" {
						<span class="tag" style="background: rgb(255 136 0 / 12%); color: var(--primary-dark); border: none; font-size: 0.75rem; padding: 0.25rem 0.5rem; line-height: 1.4;">
							{ d.Storage }
						</span>
					} else {
						<span class="tag" style="background: rgba(245,158,11,0.08); color: #92400e; border: none; font-size: 0.75rem; padding: 0.25rem 0.5rem; line-height: 1.4;">
							{ d.Raw }
						</span>
					}
				</div>
			</div>
		</div>
		if d.SizeGB > 0 {
			<div class="has-text-grey-dark" style="font-size: 0.9rem; font-weight: 500; margin-top: 0.75rem;">
				<i class="fas fa-database" style="font-size: 0.85rem; opacity: 0.6; margin-right: 6px;"></i>
				{ d.SizeLabel }
			</div>
		}
	</div>
}

templ vmDetailsCDROMStat(data VMDetailsData, T TranslationFunc) {
	<div class="column is-one-third-tablet is-half-mobile">
		<div style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 12px; padding: 1.5rem; box-shadow: 0 1px 4px rgba(0,0,0,0.04); height: 100%;">
			<div class="is-flex is-align-items-center is-justify-content-space-between mb-4">
				<div class="is-flex is-align-items-center">
					<span class="icon has-text-primary mr-3" style="font-size: 1.25rem;">
						<i class="fas fa-compact-disc"></i>
					</span>
					<div>
						<div class="has-text-grey-dark is-size-6" style="font-weight: 600;">{ T("VMDetails.Section.CDROM") }</div>
						<div class="has-text-grey is-size-7" style="margin-top: 2px;">{ T("VMDetails.Section.CDROMDescription") }</div>
					</div>
				</div>
			</div>
			<div style="margin-top: 1.5rem;">
				<div class="cdrom-item" style="background: white; border: 1px solid #e2e8f0; border-radius: 8px; padding: 1rem; transition: all 0.15s ease;">
					<div class="is-flex is-align-items-start is-justify-content-between">
						<div class="is-flex" style="gap: 0.75rem; flex: 1; min-width: 0;">
							<span class="has-text-primary" style="font-size: 1.1rem; font-weight: 600; line-height: 1;">
								<i class="fas fa-compact-disc"></i>
								{ T("VMDetails.CDROM.Drive") }
							</span>
							<div class="is-flex" style="gap: 0.5rem; flex-wrap: wrap;">
								<span class="tag" style="background: rgb(255 136 0 / 12%); color: var(--primary-dark); border: none; font-size: 0.75rem; padding: 0.25rem 0.5rem; line-height: 1.4;">
									IDE
								</span>
							</div>
						</div>
					</div>
					<div class="has-text-grey-dark" style="font-size: 0.9rem; font-weight: 500; margin-top: 0.75rem;">
						<i class="fas fa-compact-disc" style="font-size: 0.85rem; opacity: 0.6; margin-right: 6px;"></i>
						if data.CurrentISO != "" {
							{ data.CurrentISO }
						} else {
							{ T("VMDetails.CDROM.NoISO") }
						}
					</div>
				</div>
			</div>
		</div>
	</div>
}

templ vmDetailsNetworkStat(data VMDetailsData, T TranslationFunc) {
	<div class={ "column", vmDetailsNetworkColumnClass(len(data.NetworkInterfaces)) }>
		<div class="network-card" style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 12px; padding: 1.5rem; box-shadow: 0 1px 4px rgba(0,0,0,0.04); height: 100%; transition: all 0.15s ease;">
			<div class="is-flex is-align-items-center is-justify-content-space-between mb-4">
				<div class="is-flex is-align-items-center">
					<span class="icon has-text-primary mr-3" style="font-size: 1.25rem;">
						<i class="fas fa-network-wired"></i>
					</span>
					<div>
						<div class="has-text-grey-dark is-size-6" style="font-weight: 600;">{ T("VMDetails.Section.Network") }</div>
						<div class="has-text-grey is-size-7" style="margin-top: 2px;">{ T("VMDetails.Section.NetworkDescription") }</div>
					</div>
				</div>
				<div class="has-text-right">
					<div class="has-text-primary is-size-5" style="font-weight: 600;">{ strconv.Itoa(len(data.NetworkInterfaces)) }</div>
					<div class="has-text-grey is-size-7" style="margin-top: 2px;">
						if len(data.NetworkInterfaces) == 1 {
							{ T("VMDetails.Network.InterfaceSingular") }
						} else {
							{ T("VMDetails.Network.InterfacePlural") }
						}
					</div>
				</div>
			</div>
			<div style="margin-top: 1.5rem;">
				if len(data.NetworkInterfaces) > 0 {
					for i, iface := range data.NetworkInterfaces {
						@vmDetailsNetworkInterfaceItem(iface, i, len(data.NetworkInterfaces), T)
					}
				} else {
					<div class="has-text-centered" style="padding: 2rem 0;">
						<div class="has-text-grey-light" style="font-size: 2.5rem; margin-bottom: 1rem;">
							<i class="fas fa-network-wired"></i>
						</div>
						<div class="has-text-grey" style="font-size: 1rem; font-weight: 500;">
							{ T("VMDetails.Network.NoInterfaces") }
						</div>
						<div class="has-text-grey-light" style="font-size: 0.9rem; margin-top: 0.5rem;">
							{ T("VMDetails.Network.NoInterfacesDescription") }
						</div>
					</div>
				}
			</div>
		</div>
	</div>
}

templ vmDetailsNetworkInterfaceItem(iface NetworkInterface, idx int, total int, T TranslationFunc) {
	<div class="network-interface-card" style={ vmDetailsNetworkItemStyle(idx, total) }>
		<div class="is-flex is-align-items-start is-justify-content-between">
			<div class="is-flex" style="gap: 0.75rem; flex: 1; min-width: 0;">
				<span class="has-text-primary" style="font-size: 1.1rem; font-weight: 600; line-height: 1;">
					<i class="fas fa-network-wired" style="color: var(--primary);"></i>
					{ iface.Index }
				</span>
				<div class="is-flex" style="gap: 0.5rem; flex-wrap: wrap;">
					if iface.Bridge != "" {
						<span class="tag" style="background: rgb(255 136 0 / 12%); color: var(--primary-dark); border: none; font-size: 0.75rem; padding: 0.25rem 0.5rem; line-height: 1.4;">
							{ iface.Bridge }
						</span>
					}
					if iface.ModelLabel != "" {
						<span class="tag" style="background: rgb(255 136 0 / 12%); color: var(--primary-dark); border: none; font-size: 0.75rem; padding: 0.25rem 0.5rem; line-height: 1.4;">
							{ iface.ModelLabel }
						</span>
					}
					if iface.MACAddress != "" {
						<span class="tag" style="background: rgb(59 130 246 / 12%); color: #2563eb; border: none; font-size: 0.75rem; padding: 0.25rem 0.5rem; line-height: 1.4;">
							<i class="fas fa-ethernet" style="font-size: 0.7rem; margin-right: 3px;"></i>{ iface.MACAddress }
						</span>
					}
					if iface.VLAN != "" {
						<span class="tag" style="background: rgb(168 85 247 / 12%); color: #7c3aed; border: none; font-size: 0.75rem; padding: 0.25rem 0.5rem; line-height: 1.4;">
							<i class="fas fa-tags" style="font-size: 0.7rem; margin-right: 3px;"></i>VLAN { iface.VLAN }
						</span>
					}
					if iface.Rate != "" {
						<span class="tag" style="background: rgb(236 72 153 / 12%); color: #db2777; border: none; font-size: 0.75rem; padding: 0.25rem 0.5rem; line-height: 1.4;">
							<i class="fas fa-tachometer-alt" style="font-size: 0.7rem; margin-right: 3px;"></i>{ iface.Rate } MB/s
						</span>
					}
					if iface.MTU != "" && iface.MTU != "1500" {
						<span class="tag" style="background: rgb(34 197 94 / 12%); color: #16a34a; border: none; font-size: 0.75rem; padding: 0.25rem 0.5rem; line-height: 1.4;">
							<i class="fas fa-arrows-left-right-to-line" style="font-size: 0.7rem; margin-right: 3px;"></i>MTU { iface.MTU }
						</span>
					}
					if iface.LinkDown {
						<span class="tag" style="background: rgba(245,158,11,0.08); color: #d97706; border: none; font-size: 0.75rem; padding: 0.25rem 0.5rem; line-height: 1.4;">
							<i class="fas fa-link-slash" style="font-size: 0.7rem;"></i> { T("Status.Down") }
						</span>
					}
				</div>
			</div>
		</div>
		if len(iface.IPAddresses) > 0 {
			<div class="has-text-grey-dark" style="font-size: 0.9rem; font-weight: 500; margin-top: 0.75rem;">
				<i class="fas fa-ethernet has-text-primary" style="font-size: 0.85rem; margin-right: 6px;"></i>
				for j, ip := range iface.IPAddresses {
					if j > 0 {
						, 
					}
					{ ip }
				}
			</div>
		}
	</div>
}

templ vmDetailsSecurityStat(data VMDetailsData, T TranslationFunc) {
	<div class="column is-full-tablet is-full-mobile">
		<div class="security-card" style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 12px; padding: 1.5rem; box-shadow: 0 1px 4px rgba(0,0,0,0.04); height: 100%; transition: all 0.15s ease;">
			<div class="is-flex is-align-items-center is-justify-content-space-between mb-4">
				<div class="is-flex is-align-items-center">
					<span class="icon has-text-grey mr-3" style="font-size: 1.25rem;">
						<i class="fas fa-shield-alt"></i>
					</span>
					<div>
						<div class="has-text-grey-dark is-size-6" style="font-weight: 600;">{ T("VMDetails.Section.Security") }</div>
						<div class="has-text-grey is-size-7" style="margin-top: 2px;">{ T("VMDetails.Section.SecurityDescription") }</div>
					</div>
				</div>
			</div>
			<div style="margin-top: 1.5rem;">
				<div style="display: flex; flex-wrap: wrap; gap: 0.75rem;">
					@vmDetailsEFIFeature(data, T)
					@vmDetailsTPMFeature(data, T)
				</div>
			</div>
		</div>
	</div>
}

templ vmDetailsEFIFeature(data VMDetailsData, T TranslationFunc) {
	<div class="security-feature-card" style="background: white; border: 1px solid #e2e8f0; border-radius: 8px; padding: 1rem; flex: 1; min-width: 200px; transition: all 0.15s ease;">
		<div class="has-text-grey-dark" style="font-size: 0.9rem; font-weight: 500;">
			if data.EFIEnabled {
				<i class="fas fa-microchip" style="font-size: 0.85rem; opacity: 0.6; margin-right: 6px; color: #16a34a;"></i>
			} else {
				<i class="fas fa-microchip" style="font-size: 0.85rem; opacity: 0.6; margin-right: 6px;"></i>
			}
			{ T("VMDetails.Security.EFIBoot") }
			if data.EFIEnabled {
				<span class="tag" style="background: rgba(34,197,94,0.08); color: #16a34a; border: none; font-size: 0.75rem; padding: 0.25rem 0.5rem; line-height: 1.4; margin-left: 0.5rem;">
					{ T("Common.Enabled") }
				</span>
			} else {
				<span class="tag" style="background: rgba(156,163,175,0.08); color: #6b7280; border: none; font-size: 0.75rem; padding: 0.25rem 0.5rem; line-height: 1.4; margin-left: 0.5rem;">
					{ T("Common.Disabled") }
				</span>
			}
		</div>
		if data.EFIEnabled && data.EFIStorage != "" {
			<div class="has-text-grey" style="font-size: 0.85rem; margin-top: 0.5rem;">
				{ T("Common.Storage") }: { data.EFIStorage }
			</div>
		}
	</div>
}

templ vmDetailsTPMFeature(data VMDetailsData, T TranslationFunc) {
	<div class="security-feature-card" style="background: white; border: 1px solid #e2e8f0; border-radius: 8px; padding: 1rem; flex: 1; min-width: 200px; transition: all 0.15s ease;">
		<div class="has-text-grey-dark" style="font-size: 0.9rem; font-weight: 500;">
			if data.TPMEnabled {
				<i class="fas fa-shield-alt" style="font-size: 0.85rem; opacity: 0.6; margin-right: 6px; color: #16a34a;"></i>
			} else {
				<i class="fas fa-shield-alt" style="font-size: 0.85rem; opacity: 0.6; margin-right: 6px;"></i>
			}
			{ T("VMDetails.Security.TPM") }
			if data.TPMEnabled {
				<span class="tag" style="background: rgba(34,197,94,0.08); color: #16a34a; border: none; font-size: 0.75rem; padding: 0.25rem 0.5rem; line-height: 1.4; margin-left: 0.5rem;">
					{ T("Common.Enabled") }
				</span>
			} else {
				<span class="tag" style="background: rgba(156,163,175,0.08); color: #6b7280; border: none; font-size: 0.75rem; padding: 0.25rem 0.5rem; line-height: 1.4; margin-left: 0.5rem;">
					{ T("Common.Disabled") }
				</span>
			}
		</div>
	</div>
}

templ vmDetailsCloudInitStat(data VMDetailsData, T TranslationFunc) {
	<div class="column is-full-tablet is-full-mobile">
		<div class="cloudinit-card" style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 12px; padding: 1.5rem; box-shadow: 0 1px 4px rgba(0,0,0,0.04); height: 100%; transition: all 0.15s ease;">
			<div class="is-flex is-align-items-center is-justify-content-space-between mb-4">
				<div class="is-flex is-align-items-center">
					<span class="icon has-text-grey mr-3" style="font-size: 1.25rem;">
						<i class="fas fa-cloud"></i>
					</span>
					<div>
						<div class="has-text-grey-dark is-size-6" style="font-weight: 600;">{ T("VMDetails.CloudInit.Title") }</div>
						<div class="has-text-grey is-size-7" style="margin-top: 2px;">{ T("VMDetails.CloudInit.Description") }</div>
					</div>
				</div>
				if data.CloudInitEnabled {
					<span class="tag" style="background: rgba(34,197,94,0.08); color: #16a34a; border: none; font-size: 0.75rem; padding: 0.25rem 0.5rem; line-height: 1.4;">
						{ T("Common.Enabled") }
					</span>
				} else {
					<span class="tag" style="background: rgba(156,163,175,0.08); color: #6b7280; border: none; font-size: 0.75rem; padding: 0.25rem 0.5rem; line-height: 1.4;">
						{ T("Common.Disabled") }
					</span>
				}
			</div>
			if data.CloudInitEnabled {
				@vmDetailsCloudInitDetails(data, T)
			} else {
				<div class="has-text-centered" style="padding: 1rem 0;">
					<div class="has-text-grey-light" style="font-size: 2rem; margin-bottom: 0.75rem;">
						<i class="fas fa-cloud"></i>
					</div>
					<div class="has-text-grey" style="font-size: 0.9rem; font-weight: 500;">
						{ T("VMDetails.CloudInit.DisabledTitle") }
					</div>
					<div class="has-text-grey-light" style="font-size: 0.85rem; margin-top: 0.25rem;">
						{ T("VMDetails.CloudInit.DisabledSubtitle") }
					</div>
				</div>
			}
		</div>
	</div>
}

templ vmDetailsCloudInitDetails(data VMDetailsData, T TranslationFunc) {
	<div style="display: flex; flex-wrap: wrap; gap: 0.75rem;">
		<div class="cloudinit-item" style="background: white; border: 1px solid #e2e8f0; border-radius: 8px; padding: 1rem; flex: 1; min-width: 200px; transition: all 0.15s ease;">
			<div class="has-text-grey is-size-7 mb-1">{ T("VMDetails.CloudInit.User") }</div>
			<div class="has-text-grey-dark" style="font-size: 0.9rem; font-weight: 500;">
				if data.CloudInitData.User != "" {
					{ data.CloudInitData.User }
				} else {
					<span class="has-text-grey-light">—</span>
				}
			</div>
		</div>
		<div class="cloudinit-item" style="background: white; border: 1px solid #e2e8f0; border-radius: 8px; padding: 1rem; flex: 1; min-width: 200px; transition: all 0.15s ease;">
			<div class="has-text-grey is-size-7 mb-1">{ T("VMDetails.CloudInit.IPConfig") }</div>
			<div class="has-text-grey-dark" style="font-size: 0.9rem; font-weight: 500;">
				if data.CloudInitData.IPConfig != "" {
					{ data.CloudInitData.IPConfig }
				} else {
					<span class="has-text-grey-light">—</span>
				}
			</div>
		</div>
		<div class="cloudinit-item" style="background: white; border: 1px solid #e2e8f0; border-radius: 8px; padding: 1rem; flex: 1; min-width: 200px; transition: all 0.15s ease;">
			<div class="has-text-grey is-size-7 mb-1">{ T("VMDetails.CloudInit.Nameserver") }</div>
			<div class="has-text-grey-dark" style="font-size: 0.9rem; font-weight: 500;">
				if data.CloudInitData.Nameserver != "" {
					{ data.CloudInitData.Nameserver }
				} else {
					<span class="has-text-grey-light">—</span>
				}
			</div>
		</div>
	</div>
}
