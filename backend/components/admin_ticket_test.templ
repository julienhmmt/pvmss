package components

type AdminTicketTestData struct {
	Username     string
	Lang         string
	CSRFToken    string
	ProxmoxHost  string
	AuthMethod   string
	Success      bool
	SuccessMsg   string
}

templ AdminTicketTestPage(data AdminTicketTestData, T TranslationFunc) {
	@AdminLayout(AdminLayoutProps{
		Title:       T("Admin.TicketTest.Title"),
		Lang:        data.Lang,
		CurrentPath: "/admin/ticket-test",
		Username:    data.Username,
		CSRFToken:   data.CSRFToken,
		Content:     adminTicketTestContent(data, T),
		T:           T,
	})
}

templ adminTicketTestContent(data AdminTicketTestData, T TranslationFunc) {
	@AdminPageHeader(T("Admin.TicketTest.Title"), "fas fa-ticket-alt", T("Admin.TicketTest.Description"), nil)
	<div class="box admin-box">
		if data.Success {
			@Notification(NotificationProps{
				Type:        NotificationSuccess,
				Title:       T("Common.Success"),
				Message:     data.SuccessMsg,
				Icon:        "fas fa-check-circle",
				Dismissible: true,
			})
		}
		<div class="content">
			<table class="table is-fullwidth">
				<tbody>
					<tr>
						<th>{ T("Admin.TicketTest.ProxmoxHost") }</th>
						<td>{ data.ProxmoxHost }</td>
					</tr>
					<tr>
						<th>{ T("Admin.TicketTest.AuthMethod") }</th>
						<td>{ data.AuthMethod }</td>
					</tr>
				</tbody>
			</table>
		</div>
		<form method="POST" action="/admin/ticket-test">
			<input type="hidden" name="csrf_token" value={ data.CSRFToken }/>
			<div class="field">
				<div class="control">
					@Button(ButtonProps{
						Text:     T("Admin.TicketTest.TestButton"),
						Icon:     "fas fa-vial",
						Type:     ButtonPrimary,
						IsSubmit: true,
					})
				</div>
			</div>
		</form>
	</div>
}
