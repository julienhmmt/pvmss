package components

import "fmt"

type VM struct {
	VMID   int
	Name   string
	Status string
	Node   string
	CPU    float64
	CPUs   int
	Memory string
	Disk   string
}

func (v VM) IsRunning() bool {
	return v.Status == "running"
}

func (v VM) StatusClass() string {
	if v.IsRunning() {
		return "is-success"
	}
	return "is-warning"
}

func (v VM) StatusText() string {
	if v.IsRunning() {
		return "En cours"
	}
	return "Arrêtée"
}

templ VMCard(vm VM) {
	<div class="card vm-card mb-4">
		<header class="card-header">
			<p class="card-header-title">
				<span class="icon-text">
					<span class="icon has-text-primary">
						<i class="fas fa-server"></i>
					</span>
					<span>{ vm.Name }</span>
				</span>
			</p>
			<span class={ "tag", "is-medium", vm.StatusClass(), "mr-3", "mt-3" }>
				{ vm.StatusText() }
			</span>
		</header>
		<div class="card-content">
			<div class="content">
				<div class="tags has-addons mb-3">
					<span class="tag is-light">VMID</span>
					<span class="tag is-dark">{ fmt.Sprintf("%d", vm.VMID) }</span>
				</div>
				<div class="tags has-addons mb-3">
					<span class="tag is-light">Node</span>
					<span class="tag is-primary is-light">{ vm.Node }</span>
				</div>
				if vm.IsRunning() {
					<div class="columns is-mobile is-multiline">
						<div class="column is-one-third">
							<div class="has-text-centered">
								<p class="heading">CPU</p>
								<p class="title is-5">{ fmt.Sprintf("%.0f%%", vm.CPU*100) }</p>
							</div>
						</div>
						<div class="column is-one-third">
							<div class="has-text-centered">
								<p class="heading">RAM</p>
								<p class="title is-5">{ vm.Memory }</p>
							</div>
						</div>
						<div class="column is-one-third">
							<div class="has-text-centered">
								<p class="heading">Disque</p>
								<p class="title is-5">{ vm.Disk }</p>
							</div>
						</div>
					</div>
				}
			</div>
		</div>
		<footer class="card-footer">
			@Button(ButtonProps{
				Text: "Détails",
				Icon: "fas fa-eye",
				Href: fmt.Sprintf("/vm/%d", vm.VMID),
				Type: ButtonPrimary,
				Class: "card-footer-item",
			})
			if vm.IsRunning() {
				@Button(ButtonProps{
					Text: "Arrêter",
					Icon: "fas fa-stop",
					Type: ButtonDanger,
					Class: "card-footer-item",
				})
			} else {
				@Button(ButtonProps{
					Text: "Démarrer",
					Icon: "fas fa-play",
					Type: ButtonSuccess,
					Class: "card-footer-item",
				})
			}
		</footer>
	</div>
}

templ VMList(vms []VM) {
	<div class="columns is-multiline">
		for _, vm := range vms {
			<div class="column is-one-third">
				@VMCard(vm)
			</div>
		}
	</div>
}
