package components

import (
	"fmt"
	"strconv"
)

func vmCreateNetLabel(data VMCreateData, cardIdx int) string {
	if cardIdx == 0 && getVMCreateMaxNetCards(data) > 1 {
		return " #1"
	}
	return ""
}

templ vmCreateMediaNetworkCard(data VMCreateData, T TranslationFunc) {
	<div class="column is-12-tablet is-6-desktop">
		<div class="card no-hover mb-5 mt-5">
			<header class="card-header brand-header is-align-items-center">
				<p class="card-header-title">
					<span class="icon"><i class="fas fa-network-wired"></i></span>&nbsp;{ T("VM.Create.MediaNetwork") }
				</p>
			</header>
			<div class="card-content form-vertical">
				@vmCreateISOField(data, T)
				for cardIdx := 0; cardIdx < getVMCreateMaxNetCards(data); cardIdx++ {
					@vmCreateNetworkFields(data, cardIdx, T)
					if cardIdx < getVMCreateMaxNetCards(data)-1 {
						<hr class="my-4"/>
					}
				}
			</div>
		</div>
	</div>
}

templ vmCreateISOField(data VMCreateData, T TranslationFunc) {
	<div class="field">
		<label for="isoImage" class="form-label">
			<span class="form-label-icon"><span class="icon"><i class="fas fa-compact-disc"></i></span></span>
			<span class="form-label-text">{ T("VM.Create.ISOImage") }</span>
			@vmCreateTooltip("isoImage-help", T("VM.Create.Tooltip.ISO"))
		</label>
		<div class="control">
			<div class="select is-fullwidth is-medium">
				<select id="isoImage" name="iso" aria-describedby="isoImage-help">
					<option value="">-- { T("VM.Create.SelectISO") } --</option>
					if len(data.ISOs) > 0 {
						for _, iso := range data.ISOs {
							<option value={ iso } selected?={ iso == data.FormData.ISO }>{ iso }</option>
						}
					} else {
						<option disabled>{ T("VM.Create.NoISOsAvailable") }</option>
					}
				</select>
			</div>
		</div>
	</div>
}

templ vmCreateNetworkFields(data VMCreateData, cardIdx int, T TranslationFunc) {
	@vmCreateBridgeField(data, cardIdx, T)
	@vmCreateMACField(data, cardIdx, T)
	@vmCreateVLANField(data, cardIdx, T)
	@vmCreateRateLimitField(data, cardIdx, T)
	@vmCreateMTUField(data, cardIdx, T)
	@vmCreateNetworkModelField(data, cardIdx, T)
	@vmCreateNetworkEnabledField(data, cardIdx, T)
}

templ vmCreateBridgeField(data VMCreateData, cardIdx int, T TranslationFunc) {
	<div class="field">
		<label for={ fmt.Sprintf("networkBridge_%d", cardIdx) } class="form-label">
			<span class="form-label-icon"><span class="icon"><i class="fas fa-ethernet"></i></span></span>
			<span class="form-label-text">
				if cardIdx == 0 {
					{ T("VM.Create.Network") }{ vmCreateNetLabel(data, cardIdx) }
				} else {
					{ T("VM.Create.Network") } #{ strconv.Itoa(cardIdx + 1) } ({ T("VM.Create.NetworkOptional") })
				}
			</span>
			if cardIdx == 0 {
				@vmCreateTooltip("networkBridge-help", T("VM.Create.Tooltip.Network"))
			}
		</label>
		<div class="control">
			<div class="select is-fullwidth is-medium">
				<select id={ fmt.Sprintf("networkBridge_%d", cardIdx) } name={ fmt.Sprintf("bridge_%d", cardIdx) } aria-describedby="networkBridge-help">
					<option value="">-- { T("VM.Create.NoNetwork") } --</option>
					for _, bridge := range data.Bridges {
						<option value={ bridge } selected?={ vmCreateIsBridgeSelected(data, cardIdx, bridge) }>
							{ bridge }
							if node, ok := data.BridgeNodes[bridge]; ok && node != "" {
								 ({ node })
							}
							if desc, ok := data.BridgeDescriptions[bridge]; ok && desc != "" {
								 – { desc }
							}
						</option>
					}
				</select>
			</div>
		</div>
	</div>
}

templ vmCreateMACField(data VMCreateData, cardIdx int, T TranslationFunc) {
	<div class="field">
		<label for={ fmt.Sprintf("networkMACAddress_%d", cardIdx) } class="form-label">
			<span class="form-label-icon"><span class="icon"><i class="fas fa-ethernet"></i></span></span>
			<span class="form-label-text">
				if cardIdx == 0 {
					{ T("VM.Create.NetworkMACAddress") }{ vmCreateNetLabel(data, cardIdx) }
				} else {
					{ T("VM.Create.NetworkMACAddress") } #{ strconv.Itoa(cardIdx + 1) }
				}
			</span>
			if cardIdx == 0 {
				@vmCreateTooltip("networkMACAddress-help", T("VM.Create.NetworkMACAddressHelp"))
			}
		</label>
		<div class="field is-grouped">
			<div class="control is-expanded">
				<input id={ fmt.Sprintf("networkMACAddress_%d", cardIdx) } type="text" name={ fmt.Sprintf("mac_address_%d", cardIdx) } class="input is-medium" placeholder="AA:BB:CC:DD:EE:FF" pattern="^([0-9A-Fa-f]{2}:){5}([0-9A-Fa-f]{2})$" value={ data.FormData.MACAddresses[cardIdx] } aria-describedby="networkMACAddress-help"/>
			</div>
			<div class="control">
				<button type="button" class="button is-medium is-info is-light btn-generate-mac" data-target={ fmt.Sprintf("networkMACAddress_%d", cardIdx) } title={ T("VM.Create.GenerateRandomMAC") }>
					<span class="icon"><i class="fas fa-dice"></i></span>
					<span>{ T("VM.Create.Random") }</span>
				</button>
			</div>
		</div>
		if cardIdx == 0 {
			<div class="help is-size-7 has-text-grey-light mt-2">
				<p>{ T("VM.Create.NetworkMACAddressHelp") }</p>
			</div>
		}
	</div>
}

templ vmCreateVLANField(data VMCreateData, cardIdx int, T TranslationFunc) {
	<div class="field">
		<label for={ fmt.Sprintf("networkVLAN_%d", cardIdx) } class="form-label">
			<span class="form-label-icon"><span class="icon"><i class="fas fa-tags"></i></span></span>
			<span class="form-label-text">
				if cardIdx == 0 {
					{ T("VM.Create.NetworkVLAN") }{ vmCreateNetLabel(data, cardIdx) }
				} else {
					{ T("VM.Create.NetworkVLAN") } #{ strconv.Itoa(cardIdx + 1) } ({ T("VM.Create.NetworkOptional") })
				}
			</span>
			if cardIdx == 0 {
				@vmCreateTooltip("networkVLAN-help", T("VM.Create.Tooltip.NetworkVLAN"))
			}
		</label>
		<div class="control">
			<input id={ fmt.Sprintf("networkVLAN_%d", cardIdx) } type="text" name={ fmt.Sprintf("vlan_tag_%d", cardIdx) } class="input is-medium" placeholder="1-4096" pattern="[0-9]+" value={ data.FormData.VLANTags[cardIdx] } data-field-validation/>
			<div class="field-validation-message is-hidden" data-validation-for={ fmt.Sprintf("networkVLAN_%d", cardIdx) }></div>
		</div>
		if cardIdx == 0 {
			<div class="help is-size-7 has-text-grey-light mt-2">
				<p>{ T("VM.Create.NetworkVLANHelp") }</p>
			</div>
		}
	</div>
}

templ vmCreateRateLimitField(data VMCreateData, cardIdx int, T TranslationFunc) {
	<div class="field">
		<label for={ fmt.Sprintf("networkRateLimit_%d", cardIdx) } class="form-label">
			<span class="form-label-icon"><span class="icon"><i class="fas fa-tachometer-alt"></i></span></span>
			<span class="form-label-text">
				if cardIdx == 0 {
					{ T("VM.Create.NetworkRateLimit") }{ vmCreateNetLabel(data, cardIdx) }
				} else {
					{ T("VM.Create.NetworkRateLimit") } #{ strconv.Itoa(cardIdx + 1) } ({ T("VM.Create.NetworkOptional") })
				}
			</span>
			if cardIdx == 0 {
				@vmCreateTooltip("networkRateLimit-help", T("VM.Create.Tooltip.NetworkRateLimit"))
			}
		</label>
		<div class="control">
			<input id={ fmt.Sprintf("networkRateLimit_%d", cardIdx) } type="number" name={ fmt.Sprintf("rate_limit_%d", cardIdx) } class="input is-medium" placeholder="1000" min="1" max="10240" step="0.1" value={ data.FormData.RateLimits[cardIdx] } data-field-validation/>
			<div class="field-validation-message is-hidden" data-validation-for={ fmt.Sprintf("networkRateLimit_%d", cardIdx) }></div>
		</div>
		if cardIdx == 0 {
			<div class="help is-size-7 has-text-grey-light mt-2">
				<p>{ T("VM.Create.NetworkRateLimitHelp") }</p>
			</div>
		}
	</div>
}

templ vmCreateMTUField(data VMCreateData, cardIdx int, T TranslationFunc) {
	<div class="field">
		<label for={ fmt.Sprintf("networkMTU_%d", cardIdx) } class="form-label">
			<span class="form-label-icon"><span class="icon"><i class="fas fa-arrows-left-right-to-line"></i></span></span>
			<span class="form-label-text">
				if cardIdx == 0 {
					{ T("VM.Create.NetworkMTU") }{ vmCreateNetLabel(data, cardIdx) }
				} else {
					{ T("VM.Create.NetworkMTU") } #{ strconv.Itoa(cardIdx + 1) } ({ T("VM.Create.NetworkOptional") })
				}
			</span>
			if cardIdx == 0 {
				@vmCreateTooltip("networkMTU-help", T("VM.Create.Tooltip.NetworkMTU"))
			}
		</label>
		<div class="control">
			<input id={ fmt.Sprintf("networkMTU_%d", cardIdx) } type="number" name={ fmt.Sprintf("mtu_%d", cardIdx) } class="input is-medium" placeholder="1500" min="576" max="9000" step="1" value={ data.FormData.MTUs[cardIdx] }/>
		</div>
		if cardIdx == 0 {
			<div class="help is-size-7 has-text-grey-light mt-2">
				<p>{ T("VM.Create.NetworkMTUHelp") }</p>
			</div>
