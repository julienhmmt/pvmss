templ vmCreateNetworkModelField(data VMCreateData, cardIdx int, T TranslationFunc) {
	<div class="field">
		<label for={ fmt.Sprintf("networkModel_%d", cardIdx) } class="form-label">
			<span class="form-label-icon"><span class="icon"><i class="fas fa-network-wired"></i></span></span>
			<span class="form-label-text">
				if cardIdx == 0 {
					{ T("VM.Create.NetworkModel") }{ vmCreateNetLabel(data, cardIdx) }
				} else {
					{ T("VM.Create.NetworkModel") } #{ strconv.Itoa(cardIdx + 1) }
				}
			</span>
			if cardIdx == 0 {
				@vmCreateTooltip("networkModel-help", T("VM.Create.Tooltip.NetworkModel"))
			}
		</label>
		<div class="control">
			<div class="select is-fullwidth is-medium">
				<select id={ fmt.Sprintf("networkModel_%d", cardIdx) } name={ fmt.Sprintf("network_model_%d", cardIdx) } required?={ cardIdx == 0 } aria-describedby="networkModel-help">
					<option value="virtio" selected?={ vmCreateIsNetworkModelSelected(data, cardIdx, "virtio") }>VirtIO</option>
					<option value="e1000" selected?={ vmCreateIsNetworkModelSelected(data, cardIdx, "e1000") }>E1000</option>
					<option value="e1000e" selected?={ vmCreateIsNetworkModelSelected(data, cardIdx, "e1000e") }>E1000E</option>
					<option value="rtl8139" selected?={ vmCreateIsNetworkModelSelected(data, cardIdx, "rtl8139") }>RTL8139</option>
					<option value="vmxnet3" selected?={ vmCreateIsNetworkModelSelected(data, cardIdx, "vmxnet3") }>VMXNet3</option>
				</select>
			</div>
		</div>
		if cardIdx == 0 {
			<div class="help is-size-7 has-text-grey-light mt-2">
				<p class="mb-1">{ T("VM.Create.NetworkModelHelp") }</p>
			</div>
		}
	</div>
}

templ vmCreateNetworkEnabledField(data VMCreateData, cardIdx int, T TranslationFunc) {
	<div class="field">
		<label class="checkbox">
			<input type="checkbox" name={ fmt.Sprintf("network_enabled_%d", cardIdx) } value="1" checked?={ cardIdx == 0 || data.FormData.NetworkEnabled[cardIdx] == "1" }/>
			<span class="form-label-text ml-2">{ T("VM.Create.NetworkEnabled") }</span>
			@vmCreateTooltipInline(T("VM.Create.Tooltip.NetworkEnabled"))
		</label>
		<p class="help has-text-grey is-size-7 mt-2">{ T("VM.Create.NetworkEnabledHelp") }</p>
	</div>
}
