package components

import (
	"fmt"
	"strconv"
)

func vmCreateDiskLabel(data VMCreateData, diskIdx int) string {
	if diskIdx == 0 && getVMCreateMaxDisks(data) > 1 {
		return " #1"
	}
	return ""
}

func vmCreateNodeOptionClass(disabled bool) string {
	if disabled {
		return "has-text-grey-light"
	}
	return ""
}

templ vmCreateBasicInfoCard(data VMCreateData, T TranslationFunc) {
	<div class="column is-12-tablet is-6-desktop">
		<div class="card no-hover mb-5">
			<header class="card-header brand-header is-align-items-center">
				<p class="card-header-title">
					<span class="icon"><i class="fas fa-info-circle"></i></span>&nbsp;{ T("VM.Create.BasicInfo") }
				</p>
			</header>
			<div class="card-content form-vertical">
				@vmCreateNameField(data, T)
				@vmCreateDescriptionField(data, T)
				@vmCreateIdField(data, T)
				@vmCreateTPMField(data, T)
				@vmCreateStartField(data, T)
				@vmCreateNodeField(data, T)
				@vmCreatePoolField(data, T)
			</div>
		</div>
	</div>
}

templ vmCreateNameField(data VMCreateData, T TranslationFunc) {
	<div class="field">
		<label for="vmName" class="form-label">
			<span class="form-label-icon"><span class="icon"><i class="fas fa-tag"></i></span></span>
			<span class="form-label-text">{ T("VM.Create.VMName") }</span>
			@vmCreateTooltip("vmName-help", T("VM.Create.Tooltip.VMName"))
		</label>
		<div class="control">
			<input id="vmName" class="input is-medium" type="text" name="name" autocomplete="off" placeholder={ T("VM.Create.PlaceholderVMName") } maxlength="100" value={ data.FormData.Name } aria-describedby="vmName-help" data-field-validation/>
			<div class="field-validation-message is-hidden" data-validation-for="vmName"></div>
		</div>
	</div>
}

templ vmCreateDescriptionField(data VMCreateData, T TranslationFunc) {
	<div class="field">
		<label for="vmDescription" class="form-label">
			<span class="form-label-icon"><span class="icon"><i class="fas fa-align-left"></i></span></span>
			<span class="form-label-text">{ T("VM.Create.Description") }</span>
			@vmCreateTooltip("vmDescription-help", T("VM.Create.Tooltip.Description"))
		</label>
		<div class="control">
			<textarea id="vmDescription" class="textarea" name="description" placeholder={ T("VM.Create.DescriptionPlaceholder") } rows="3" aria-describedby="vmDescription-help" maxlength="500">{ data.FormData.Description }</textarea>
		</div>
	</div>
}

templ vmCreateIdField(data VMCreateData, T TranslationFunc) {
	<div class="field">
		<label for="vmId" class="form-label">
			<span class="form-label-icon"><span class="icon"><i class="fas fa-hashtag"></i></span></span>
			<span class="form-label-text">{ T("VM.Create.VMID") }</span>
			@vmCreateTooltip("vmId-help", T("VM.Create.Tooltip.VMID"))
		</label>
		<div class="control">
			<input id="vmId" class="input is-medium" type="number" name="vmid" value={ data.FormData.VMID } min="100" max="999999999" placeholder={ T("VM.Create.VMIDPlaceholder") } aria-describedby="vmId-help" inputmode="numeric" pattern="[0-9]*"/>
		</div>
	</div>
}

templ vmCreateTPMField(data VMCreateData, T TranslationFunc) {
	<div class="field">
		<label class="checkbox">
			<input type="checkbox" name="enable_tpm" value="1" checked?={ data.FormData.EnableTPM == "1" }/>
			<span class="form-label-text ml-2">{ T("VM.Create.EnableTPM") }</span>
			@vmCreateTooltipInline(T("VM.Create.Tooltip.TPM"))
		</label>
		<p class="help has-text-grey is-size-7 mt-2">{ T("VM.Create.TPMHelp") }</p>
	</div>
}

templ vmCreateStartField(data VMCreateData, T TranslationFunc) {
	<div class="field">
		<label class="checkbox">
			<input type="checkbox" name="start_vm" value="1" checked?={ data.FormData.StartVM == "1" || data.FormData.StartVM == "" }/>
			<span class="form-label-text ml-2">{ T("VM.Create.StartVM") }</span>
			@vmCreateTooltipInline(T("VM.Create.Tooltip.StartVM"))
		</label>
		<p class="help has-text-grey is-size-7 mt-2">{ T("VM.Create.StartVMHelp") }</p>
	</div>
}

templ vmCreateNodeField(data VMCreateData, T TranslationFunc) {
	<div class="field">
		<label for="node" class="form-label">
			<span class="form-label-icon"><span class="icon"><i class="fas fa-server"></i></span></span>
			<span class="form-label-text">{ T("VM.Create.ProxmoxNode") }</span>
			@vmCreateTooltip("node-help", T("VM.Create.Tooltip.Node"))
		</label>
		<div class="control">
			<div class="select is-fullwidth is-medium">
				<select id="node" name="node" required aria-required="true" aria-describedby="node-help">
					<option value="">-- { T("VM.Create.SelectNode") } --</option>
					if len(data.NodeOptions) > 0 {
						for _, opt := range data.NodeOptions {
							<option value={ opt.Value } data-cores-max={ strconv.Itoa(opt.CoresMax) } data-ram-max-gb={ strconv.Itoa(opt.RamMaxGB) } selected?={ opt.IsSelected } disabled?={ opt.Disabled } class={ vmCreateNodeOptionClass(opt.Disabled) }>
								{ opt.Text }
								if opt.Disabled && opt.Reason != "" {
									 — { opt.Reason }
								}
							</option>
						}
					} else {
						for _, node := range data.Nodes {
							<option value={ node } selected?={ node == data.FormData.Node || node == data.ActiveNode }>{ node }</option>
						}
					}
					if len(data.Nodes) == 0 && len(data.NodeOptions) == 0 {
						<option disabled>{ T("VM.Create.NoNodesAvailable") }</option>
					}
				</select>
			</div>
		</div>
		<p class="help is-size-7 has-text-grey-light mt-2">{ T("VM.Create.ProxmoxNodeHelp") }</p>
	</div>
}

templ vmCreatePoolField(data VMCreateData, T TranslationFunc) {
	<div class="field">
		<label for="pool" class="form-label">
			<span class="form-label-icon"><span class="icon"><i class="fas fa-layer-group"></i></span></span>
			<span class="form-label-text">{ T("VM.Create.ResourcePool") }</span>
			@vmCreateTooltip("pool-help", T("VM.Create.Tooltip.Pool"))
		</label>
		<div class="control">
			<input id="pool" class="input is-medium" type="text" name="pool" value={ getVMCreatePoolValue(data) } placeholder="pvmss_<user>" readonly aria-readonly="true"/>
		</div>
	</div>
}

templ vmCreateTooltip(id string, text string) {
	<span class="form-tooltip">
		<button type="button" class="form-tooltip-trigger" aria-label={ text }><i class="fas fa-info"></i></button>
		<div id={ id } class="form-tooltip-content" role="tooltip">{ text }</div>
	</span>
}

templ vmCreateTooltipInline(text string) {
	<span class="form-tooltip ml-2">
		<button type="button" class="form-tooltip-trigger" aria-label={ text }><i class="fas fa-info"></i></button>
		<div class="form-tooltip-content" role="tooltip">{ text }</div>
	</span>
}

templ vmCreateResourcesCard(data VMCreateData, T TranslationFunc) {
	<div class="column is-12-tablet is-6-desktop">
		<div class="card no-hover mb-5">
			<header class="card-header brand-header is-align-items-center">
				<p class="card-header-title">
					<span class="icon"><i class="fas fa-server"></i></span>&nbsp;{ T("VM.Create.Resources") }
				</p>
			</header>
			<div class="card-content form-vertical">
				@vmCreateCPUField(data, T)
				@vmCreateMemoryField(data, T)
				@vmCreateDiskBusField(data, T)
				for diskIdx := 0; diskIdx < getVMCreateMaxDisks(data); diskIdx++ {
					@vmCreateDiskField(data, diskIdx, T)
				}
				@vmCreateStorageField(data, T)
				@vmCreateEFIField(data, T)
			</div>
		</div>
	</div>
}

templ vmCreateCPUField(data VMCreateData, T TranslationFunc) {
	<div class="field">
		<label class="form-label">
			<span class="form-label-icon"><span class="icon"><i class="fas fa-microchip"></i></span></span>
			<span class="form-label-text">{ T("VM.Create.CPUCores") }</span>
			@vmCreateTooltip("cpu-tooltip", T("VM.Create.Tooltip.CPU"))
		</label>
		<div class="columns is-mobile form-inline-fields is-variable is-2">
			<div class="column">
				<span class="form-sublabel">{ T("VM.Create.CPUSockets") }</span>
				<div class="control">
					<div class="select is-fullwidth is-medium">
						<select id="cpuSockets" name="sockets" required aria-required="true" aria-describedby="cpu-tooltip">
							for i := data.VMSocketsMin; i <= data.VMSocketsMax; i++ {
								<option value={ strconv.Itoa(i) } selected?={ i == data.VMSocketsMin }>{ strconv.Itoa(i) }</option>
							}
						</select>
					</div>
				</div>
			</div>
			<div class="column">
				<span class="form-sublabel">{ T("VM.Create.CPUCores") }</span>
				<div class="control">
					<div class="select is-fullwidth is-medium">
						<select id="cpuCores" name="cores" required aria-required="true" aria-describedby="cpu-tooltip">
							for i := data.VMCoresMin; i <= data.VMCoresMax; i++ {
								<option value={ strconv.Itoa(i) } selected?={ i == data.VMCoresMin }>{ strconv.Itoa(i) }</option>
							}
						</select>
					</div>
				</div>
			</div>
		</div>
	</div>
}

templ vmCreateMemoryField(data VMCreateData, T TranslationFunc) {
	<div class="field">
		<label for="memory" class="form-label">
			<span class="form-label-icon"><span class="icon"><i class="fas fa-memory"></i></span></span>
			<span class="form-label-text">{ T("Common.Memory") }</span>
			@vmCreateTooltip("memory-help", T("VM.Create.Tooltip.Memory"))
		</label>
		<div class="field has-addons">
			<div class="control is-expanded">
				<input id="memory" class="input is-medium" type="number" name="memory" min={ strconv.Itoa(data.VMRamMinMB) } max={ strconv.Itoa(data.VMRamMaxMB) } step="256" value={ strconv.Itoa(data.VMRamMinMB) } required aria-required="true" aria-describedby="memory-help" inputmode="numeric" placeholder={ fmt.Sprintf("e.g., %d", data.VMRamMinMB) } data-min-mb={ strconv.Itoa(data.VMRamMinMB) } data-max-mb={ strconv.Itoa(data.VMRamMaxMB) }/>
			</div>
			<div class="control">
				<div class="select is-medium">
					<select id="memory-unit" name="memory_unit">
						<option value="MB">MB</option>
						<option value="GB">GB</option>
					</select>
				</div>
			</div>
		</div>
		<p class="help has-text-grey is-size-7 mt-2">
			<span class="icon is-small has-text-primary"><i class="fas fa-info-circle"></i></span>
			<span id="memory-display" data-selected-label={ T("Common.Selected") }>{ T("Common.Selected") }: { fmt.Sprintf("%.1f", float64(data.VMRamMinMB)/1024) } GB ({ strconv.Itoa(data.VMRamMinMB) } MB)</span>
			<span class="ml-2">• { T("Common.Min") }: { strconv.Itoa(data.VMRamMinMB) } MB</span>
			<span class="ml-2">• { T("Common.Max") }: { strconv.Itoa(data.VMRamMaxMB) } MB</span>
		</p>
	</div>
}

templ vmCreateDiskBusField(data VMCreateData, T TranslationFunc) {
	<div class="field">
		<label for="diskBusType" class="form-label">
			<span class="form-label-icon"><span class="icon"><i class="fas fa-microchip"></i></span></span>
			<span class="form-label-text">{ T("VM.Create.DiskBusType") }</span>
			@vmCreateTooltip("diskBusType-help", T("VM.Create.Tooltip.DiskBusType"))
		</label>
		<div class="control">
			<div class="select is-fullwidth is-medium">
				<select id="diskBusType" name="disk_bus_type" required aria-describedby="diskBusType-help">
					<option value="virtio" selected?={ data.FormData.DiskBusType == "" || data.FormData.DiskBusType == "virtio" }>VirtIO Block</option>
					<option value="scsi" selected?={ data.FormData.DiskBusType == "scsi" }>SCSI</option>
					<option value="sata" selected?={ data.FormData.DiskBusType == "sata" }>SATA</option>
					<option value="ide" selected?={ data.FormData.DiskBusType == "ide" }>IDE</option>
				</select>
			</div>
		</div>
		<div class="help is-size-7 has-text-grey-light mt-2">
			<p class="mb-1">{ T("VM.Create.DiskBusTypeHelp") }</p>
		</div>
	</div>
}

templ vmCreateDiskField(data VMCreateData, diskIdx int, T TranslationFunc) {
	<div class="field">
		<label for={ fmt.Sprintf("diskSize_%d", diskIdx) } class="form-label">
			<span class="form-label-icon"><span class="icon"><i class="fas fa-hdd"></i></span></span>
			<span class="form-label-text">
				if diskIdx == 0 {
					{ T("VM.Create.DiskSize") }{ vmCreateDiskLabel(data, diskIdx) }
				} else {
					{ T("VM.Create.DiskSize") } #{ strconv.Itoa(diskIdx + 1) } ({ T("VM.Create.DiskOptional") })
				}
			</span>
			if diskIdx == 0 {
				@vmCreateTooltip("diskSize-help", T("VM.Create.Tooltip.DiskSize"))
			}
		</label>
		<div class="field has-addons">
			<div class="control is-expanded">
				<input id={ fmt.Sprintf("diskSize_%d", diskIdx) } class="input is-medium" type="number" name={ fmt.Sprintf("disk_size_%d", diskIdx) } min={ vmCreateDiskMin(data, diskIdx) } max={ strconv.Itoa(data.VMDiskMax) } step={ vmCreateDiskStep(diskIdx) } value={ vmCreateDiskValue(data, diskIdx) } required?={ diskIdx == 0 } aria-describedby="diskSize-help" inputmode="numeric"/>
			</div>
			<div class="control">
				<div class="select is-medium">
					<select id={ fmt.Sprintf("diskSize-unit-%d", diskIdx) } name={ fmt.Sprintf("disk_size_unit_%d", diskIdx) }>
						<option value="GB">GB</option>
						<option value="MB">MB</option>
					</select>
				</div>
			</div>
		</div>
		if diskIdx == 0 {
			<p class="help has-text-grey is-size-7 mt-2">
				<span class="icon is-small has-text-primary"><i class="fas fa-info-circle"></i></span>
				<span id={ fmt.Sprintf("diskSize-display-%d", diskIdx) }>{ T("Common.Selected") }: { strconv.Itoa(data.VMDiskMin) } GB</span>
				<span class="ml-2">• { T("Common.Min") }: { strconv.Itoa(data.VMDiskMin) } GB</span>
				<span class="ml-2">• { T("Common.Max") }: { strconv.Itoa(data.VMDiskMax) } GB</span>
			</p>
		}
	</div>
}

templ vmCreateStorageField(data VMCreateData, T TranslationFunc) {
	<div class="field">
		<label for="storage" class="form-label">
			<span class="form-label-icon"><span class="icon"><i class="fas fa-database"></i></span></span>
			<span class="form-label-text">{ T("VM.Create.Storage") }</span>
			@vmCreateTooltip("storage-help", T("VM.Create.Tooltip.Storage"))
		</label>
		<div class="control">
			<div class="select is-fullwidth is-medium">
				<select id="storage" name="storage" required aria-required="true" aria-describedby="storage-help">
					<option value="">-- { T("VM.Create.SelectStorage") } --</option>
					if len(data.Storages) > 0 {
						for _, storage := range data.Storages {
							<option value={ storage } selected?={ storage == data.FormData.Storage }>
								{ storage }
								if node, ok := data.StorageNodes[storage]; ok && node != "" {
									 ({ node })
								} else {
									 ({ T("VM.Create.Shared") })
								}
							</option>
						}
					} else {
						<option disabled>{ T("VM.Create.NoStoragesAvailable") }</option>
					}
				</select>
			</div>
		</div>
	</div>
}

templ vmCreateEFIField(data VMCreateData, T TranslationFunc) {
	<div class="field">
		<label class="checkbox">
			<input type="checkbox" name="enable_efi" value="1" checked?={ data.FormData.EnableEFI == "1" || data.FormData.EnableEFI == "" }/>
			<span class="form-label-text ml-2">{ T("VM.Create.EnableEFI") }</span>
			@vmCreateTooltipInline(T("VM.Create.Tooltip.EFI"))
		</label>
		<p class="help has-text-grey is-size-7 mt-2">{ T("VM.Create.EFIHelp") }</p>
	</div>
}

templ vmCreateTagsCard(data VMCreateData, T TranslationFunc) {
	<div class="column is-12-tablet is-6-desktop">
		<div class="card no-hover mb-5 mt-5">
			<header class="card-header brand-header is-align-items-center">
				<p class="card-header-title">
					<span class="icon"><i class="fas fa-tags"></i></span>&nbsp;{ T("VM.Create.Tags") }
				</p>
			</header>
			<div class="card-content form-vertical">
				<div class="field">
					<label class="form-label">
						<span class="form-label-icon"><span class="icon"><i class="fas fa-tag"></i></span></span>
						<span class="form-label-text">{ T("VM.Create.AvailableTags") }</span>
					</label>
					<div class="tags are-medium">
						if len(data.AvailableTags) > 0 {
							<span class="tag is-primary is-medium">pvmss</span>
							<input type="hidden" name="tags" value="pvmss"/>
							for _, tag := range data.AvailableTags {
								if tag != "pvmss" {
									<label>
										<input type="checkbox" name="tags" value={ tag } class="is-hidden"/>
										<span class="tag is-light is-medium">{ tag }</span>
									</label>
								}
							}
						} else {
							<span class="tag is-light is-medium">{ T("VM.Create.NoTagsAvailable") }</span>
						}
					</div>
					<p class="help has-text-grey is-size-7 mt-2">{ T("VM.Create.TagsHelp") }</p>
				</div>
			</div>
		</div>
	</div>
}
