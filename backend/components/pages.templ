package components

templ IndexPage(vms []VM, username string, isAdmin bool) {
	@Layout(LayoutProps{
		Title:            "Mes VMs",
		Lang:             "fr",
		IsAuthenticated:  true,
		Username:         username,
		IsAdmin:          isAdmin,
		ProxmoxConnected: true,
		CSRFToken:        "",
		Content:          indexContent(vms),
	})
}

templ indexContent(vms []VM) {
	<div class="section">
		<h1 class="title is-2">
			<span class="icon-text">
				<span class="icon has-text-primary">
					<i class="fas fa-server"></i>
				</span>
				<span>Mes Machines Virtuelles</span>
			</span>
		</h1>
		if len(vms) > 0 {
			@Notification(NotificationProps{
				Type:    NotificationInfo,
				Message: "Vous avez actuellement " + string(rune(len(vms))) + " VM(s) actives",
				Light:   true,
			})
			@VMList(vms)
		} else {
			@emptyState()
		}
	</div>
}

templ emptyState() {
	@Card(CardProps{
		Title:   "Aucune VM",
		Icon:    "fas fa-inbox",
		Content: emptyStateContent(),
	})
}

templ emptyStateContent() {
	<div class="has-text-centered py-6">
		<span class="icon is-large has-text-grey-light mb-4">
			<i class="fas fa-server fa-3x"></i>
		</span>
		<p class="subtitle has-text-grey">Vous n'avez pas encore de machine virtuelle</p>
		<div class="buttons is-centered mt-4">
			@Button(ButtonProps{
				Text: "Créer ma première VM",
				Icon: "fas fa-plus",
				Href: "/vm/create",
				Type: ButtonPrimary,
				Size: ButtonMedium,
			})
		</div>
	</div>
}
