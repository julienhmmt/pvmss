package components

type CardProps struct {
	Title        string
	Icon         string
	HeaderClass  string
	Class        string
	Content      templ.Component
	Footer       templ.Component
}

templ Card(props CardProps) {
	<div class={ "card", props.Class }>
		if props.Title != "" || props.Icon != "" {
			<header class={ "card-header", props.HeaderClass }>
				<p class="card-header-title">
					if props.Icon != "" {
						<span class="icon mr-2">
							<i class={ props.Icon }></i>
						</span>
					}
					<span>{ props.Title }</span>
				</p>
			</header>
		}
		<div class="card-content">
			@props.Content
		</div>
		if props.Footer != nil {
			<footer class="card-footer">
				@props.Footer
			</footer>
		}
	</div>
}

templ AdminCard(title string, icon string, content templ.Component) {
	@Card(CardProps{
		Title:       title,
		Icon:        icon,
		HeaderClass: "brand-header",
		Class:       "admin-card",
		Content:     content,
	})
}
