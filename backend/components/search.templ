package components

type SearchData struct {
	Lang     string
	Username string
	CSRFToken string
}

templ SearchPage(data SearchData, T TranslationFunc) {
	@Layout(LayoutProps{
		Title:            T("Search.Title"),
		Lang:             data.Lang,
		CurrentPath:      "/search",
		IsAuthenticated:  true,
		IsAdmin:          false,
		Username:         data.Username,
		ProxmoxConnected: true,
		CSRFToken:        data.CSRFToken,
		T:                T,
		Content:          searchContent(T),
	})
}

templ searchContent(T TranslationFunc) {
	<section class="section">
		<div class="container">
			@searchHeader(T)
			@searchFormCard(T)
			@searchResultsCard(T)
			@searchTranslations(T)
		</div>
	</section>
	<script src="/js/vm-utils.js" defer></script>
	<script src="/js/search-page.js" defer></script>
}

templ searchHeader(T TranslationFunc) {
	@PageHeader(PageHeaderProps{
		Title:   T("Search.Title"),
		Icon:    "fas fa-magnifying-glass",
		Actions: searchHeaderActions(T),
	})
}

templ searchHeaderActions(T TranslationFunc) {
	<div class="buttons are-small">
		@Button(ButtonProps{
			Text: T("Profile.CreateVM"),
			Icon: "fas fa-plus-square",
			Href: "/vm/create",
			Type: ButtonPrimary,
			Size: ButtonSmall,
		})
		@Button(ButtonProps{
			Text: T("Profile.MyProfile"),
			Icon: "fas fa-user",
			Href: "/profile",
			Type: ButtonPrimary,
			Size: ButtonSmall,
			Class: "is-light has-text-dark",
		})
	</div>
}

templ searchFormCard(T TranslationFunc) {
	<div class="card mb-5">
		<header class="card-header brand-header">
			<p class="card-header-title">
				<span class="icon-text">
					<span class="icon"><i class="fas fa-filter"></i></span>
					<span>{ T("Search.Criterias") }</span>
				</span>
			</p>
		</header>
		<div class="card-content">
			<p class="mb-4 has-text-grey">{ T("Search.Subtitle") }</p>
			<div class="search-controls mb-4">
				<div class="columns is-variable is-4">
					<div class="column">
						<div class="field">
							<label class="label">{ T("Search.VMID") }</label>
							<div class="control has-icons-left">
								<input class="input" type="text" id="vmid-search" placeholder={ T("Search.PlaceholderVMID") }/>
								<span class="icon is-small is-left">
									<i class="fas fa-hashtag"></i>
								</span>
							</div>
						</div>
					</div>
					<div class="column">
						<div class="field">
							<label class="label">{ T("Search.Name") }</label>
							<div class="control has-icons-left">
								<input class="input" type="text" id="name-search" placeholder={ T("Search.PlaceholderName") }/>
								<span class="icon is-small is-left">
									<i class="fas fa-server"></i>
								</span>
							</div>
						</div>
					</div>
					<div class="column">
						<div class="field">
							<label class="label">{ T("Search.Tags") }</label>
							<div class="control has-icons-left">
								<input class="input" type="text" id="tags-filter" placeholder={ T("Search.PlaceholderTag") }/>
								<span class="icon is-small is-left">
									<i class="fas fa-tags"></i>
								</span>
							</div>
							<p class="help is-size-7">{ T("Search.TagsHelp") }</p>
						</div>
					</div>
				</div>
				<div class="level">
					<div class="level-left">
						<div class="level-item">
							<button class="button is-primary" id="search-btn">
								<span class="icon"><i class="fas fa-search"></i></span>
								<span>{ T("Search.Search") }</span>
							</button>
							<button class="button is-light ml-2" id="clear-btn">
								<span class="icon"><i class="fas fa-times"></i></span>
								<span>{ T("Search.Clear") }</span>
							</button>
						</div>
					</div>
					<div class="level-right">
						<div class="level-item">
							<div class="field">
								<label class="label is-small">{ T("Search.Limit") }</label>
								<div class="control">
									<div class="select is-small">
										<select id="limit-select">
											<option value="25">25</option>
											<option value="50" selected>50</option>
											<option value="100">100</option>
											<option value="200">200</option>
										</select>
									</div>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
			<div id="search-loading" class="has-text-centered is-hidden mb-4">
				<div class="icon is-large has-text-primary">
					<i class="fas fa-spinner fa-spin fa-2x"></i>
				</div>
				<p class="has-text-grey">{ T("Search.Searching") }</p>
			</div>
			<div id="search-error" class="notification is-danger is-hidden">
				<button class="delete" id="error-close"></button>
				<span id="error-message"></span>
			</div>
		</div>
	</div>
}

templ searchResultsCard(T TranslationFunc) {
	<div id="search-results" class="is-hidden">
		<div class="card">
			<header class="card-header brand-header">
				<p class="card-header-title">
					<span class="icon-text">
						<span class="icon"><i class="fas fa-list"></i></span>
						<span>{ T("Search.Results") }</span>
					</span>
				</p>
			</header>
			<div class="card-content">
				<div id="results-container">
					<!-- Results will be loaded here via AJAX -->
				</div>
			</div>
		</div>
	</div>
}

templ searchTranslations(T TranslationFunc) {
	<div
		id="search-translations"
		class="is-hidden"
		aria-hidden="true"
		data-actions={ T("Search.Actions") }
		data-description={ T("Search.Description") }
		data-details={ T("Search.Details") }
		data-load-error={ T("Search.LoadError") }
		data-name={ T("Search.Name") }
		data-no-description={ T("Search.NoDescription") }
		data-no-name={ T("Search.NoName") }
		data-no-results={ T("Search.NoResults") }
		data-no-results-message={ T("Search.NoResultsMessage") }
		data-no-tags={ T("Search.NoTags") }
		data-node={ T("Search.Node") }
		data-result-found={ T("Search.ResultFound") }
		data-results-found={ T("Search.ResultsFound") }
		data-search={ T("Search.Search") }
		data-search-error={ T("Search.Error") }
		data-searching={ T("Search.Searching") }
		data-status={ T("Search.Status") }
		data-status-running={ T("Status.Running") }
		data-status-stopped={ T("Status.Stopped") }
		data-status-paused={ T("Status.Paused") }
		data-status-unknown={ T("Status.Unknown") }
		data-tags={ T("Search.Tags") }
		data-vmid={ T("Search.VMID") }
	></div>
}
