package components

import (
	"fmt"
	"strconv"
)

templ vmDetailsCelebrationBanner(data VMDetailsData, T TranslationFunc) {
	<div
		id="vm-celebration-banner"
		class="notification is-success is-light mb-4"
		style="border: 2px solid #48c774; background: linear-gradient(135deg, rgba(72,199,116,0.1) 0%, rgba(72,199,116,0.05) 100%); animation: slideInBounce 0.8s ease-out;"
	>
		<button class="delete" onclick="dismissCelebration()"></button>
		<div class="media">
			<div class="media-left">
				<span class="icon has-text-success" style="font-size: 1.5rem;">
					<i class="fas fa-check-circle"></i>
				</span>
			</div>
			<div class="media-content">
				<p class="has-text-weight-semibold mb-2" style="color: #2d5a3d;">
					<i class="fas fa-rocket" style="margin-right: 0.5rem;"></i>
					{ T("VMDetails.Celebration.Title") }
				</p>
				<p style="color: #2d5a3d; margin-bottom: 0.5rem;">
					{ T("VMDetails.Celebration.Message") }
				</p>
				<div style="margin-top: 0.75rem;">
					<div class="buttons">
						<button class="button is-small is-success" id="start-vm-button">
							<span class="icon is-small"><i class="fas fa-play"></i></span>
							<span>{ T("VMDetails.Celebration.StartNow") }</span>
						</button>
						<button class="button is-small is-info" id="open-console-button">
							<span class="icon is-small"><i class="fas fa-terminal"></i></span>
							<span>{ T("VMDetails.Celebration.OpenConsole") }</span>
						</button>
						<button class="button is-small is-primary" id="edit-resources-button">
							<span class="icon is-small"><i class="fas fa-sliders"></i></span>
							<span>{ T("VMDetails.Celebration.EditResources") }</span>
						</button>
					</div>
				</div>
			</div>
		</div>
	</div>
}

templ vmDetailsOverviewCard(data VMDetailsData, T TranslationFunc) {
	<div class="card mb-4">
		@vmDetailsHeader(data, T)
		<div class="card-content pt-4 pb-3 px-3">
			<div class="columns is-mobile is-multiline is-variable is-2">
				@vmDetailsCPUStat(data, T)
				@vmDetailsRAMStat(data, T)
				@vmDetailsDiskStat(data, T)
				@vmDetailsCDROMStat(data, T)
				@vmDetailsNetworkStat(data, T)
				@vmDetailsSecurityStat(data, T)
				@vmDetailsCloudInitStat(data, T)
			</div>
		</div>
		@vmDetailsQuickActions(data, T)
	</div>
}

templ vmDetailsHeader(data VMDetailsData, T TranslationFunc) {
	<header class="card-header brand-header is-align-items-center">
		<p class="card-header-title">
			<span class="icon-text">
				<span class="icon"><i class="fas fa-server"></i></span>
				<span>{ data.VM.Name } ({ strconv.Itoa(data.VM.VMID) })</span>
			</span>
		</p>
		<div class="card-header-icon">
			@vmDetailsStatusBadge(data.VM.Status, T)
		</div>
	</header>
}

templ vmDetailsQuickActions(data VMDetailsData, T TranslationFunc) {
	<div class="card-content pt-0 pb-4 px-4" style="border-top: 1px solid rgb(0,0,0,6%);">
		<div class="has-text-centered mb-2 mt-3">
			<span class="has-text-grey is-size-7" style="text-transform: uppercase; font-weight: 600; letter-spacing: 0.05em;">{ T("VMDetails.QuickActions") }</span>
		</div>
		@VMActionButtons(VMActionButtonsProps{
			VMID:             data.VM.VMID,
			Node:             data.VM.Node,
			Status:           data.VM.Status,
			CSRFToken:        data.CSRFToken,
			ProxmoxConnected: data.ProxmoxConnected,
			ExtraClasses:     "is-flex-wrap-wrap is-justify-content-center enhanced-loading",
		}, T)
		if data.ProxmoxConnected {
			<div class="has-text-centered mt-4 pt-3" style="border-top: 1px solid rgb(0,0,0,6%);">
				<a href={ templ.SafeURL(fmt.Sprintf("/vm/details/%d?edit=resources", data.VM.VMID)) } class="button is-primary">
					<span class="icon is-small"><i class="fas fa-sliders"></i></span>
					<span>{ T("VMDetails.ModifyResources") }</span>
				</a>
			</div>
		}
	</div>
}

templ vmDetailsDescriptionTagsGrid(data VMDetailsData, T TranslationFunc) {
	<div class="columns is-variable is-5">
		<div class={ "column", vmDetailsDescColumnClass(data.Tags) }>
			<div class="card mb-5">
				<header class="card-header brand-header is-align-items-center">
					<p class="card-header-title">
						<span class="icon-text">
							<span class="icon"><i class="fas fa-info-circle"></i></span>
							<span>{ T("VMDetails.Label.Description") }</span>
						</span>
					</p>
					if data.ProxmoxConnected {
						<a href={ templ.SafeURL(fmt.Sprintf("/vm/details/%d?edit=description", data.VM.VMID)) } class="button is-light mr-3">
							<span class="icon is-small"><i class="fas fa-edit"></i></span>
							<span class="is-hidden-mobile">{ T("VMDetails.Modify") }</span>
						</a>
					}
				</header>
				<div class="card-content content">
					if data.Description != "" {
						if data.DescriptionHTML != "" {
							@templ.Raw(data.DescriptionHTML)
						} else {
							<p>{ data.Description }</p>
						}
					} else {
						<p class="has-text-grey-light is-italic mb-0">{ T("VMDetails.NoDescription") }</p>
					}
				</div>
			</div>
		</div>
		if data.Tags != "" {
			<div class="column is-5">
				<div class="card mb-5">
					<header class="card-header brand-header is-align-items-center">
						<p class="card-header-title">
							<span class="icon-text">
								<span class="icon"><i class="fas fa-tags"></i></span>
								<span>{ T("Common.Tags") }</span>
							</span>
						</p>
						if data.ProxmoxConnected {
							<a href={ templ.SafeURL(fmt.Sprintf("/vm/details/%d?edit=tags", data.VM.VMID)) } class="button is-light mr-3">
								<span class="icon is-small"><i class="fas fa-edit"></i></span>
								<span class="is-hidden-mobile">{ T("VMDetails.Modify") }</span>
							</a>
						}
					</header>
					<div class="card-content">
						<div class="tags are-medium">
							for _, tag := range vmDetailsSplitTags(data.Tags) {
								<span class="tag tag-pvmss">{ tag }</span>
							}
						</div>
					</div>
				</div>
			</div>
		}
	</div>
}

templ vmDetailsDescriptionEditor(data VMDetailsData, T TranslationFunc) {
	<div class="card mb-5">
		<header class="card-header brand-header">
			<p class="card-header-title">
				<span class="icon-text">
					<span class="icon"><i class="fas fa-edit"></i></span>
					<span>{ T("VMDetails.EditDescriptionTitle") }</span>
				</span>
			</p>
		</header>
		<div class="card-content">
			<form action="/vm/update/description" method="post">
				<input type="hidden" name="csrf_token" value={ data.CSRFToken }/>
				<input type="hidden" name="vmid" value={ strconv.Itoa(data.VM.VMID) }/>
				<input type="hidden" name="node" value={ data.VM.Node }/>
				<div class="field">
					<label for="description" class="label has-text-weight-semibold">{ T("VMDetails.DescriptionLabel") }</label>
					<div class="control">
						<textarea id="description" name="description" class="textarea" rows="6" placeholder={ T("VMDetails.DescriptionPlaceholder") }>{ data.Description }</textarea>
					</div>
					<p class="help has-text-grey">{ T("VMDetails.DescriptionHelp") }</p>
				</div>
				<hr class="my-4"/>
				<div class="field is-grouped is-justify-content-space-between">
					<div class="control">
						<a class="button is-light" href={ templ.SafeURL(fmt.Sprintf("/vm/details/%d", data.VM.VMID)) }>
							<span class="icon"><i class="fas fa-times"></i></span>
							<span>{ T("Common.Cancel") }</span>
						</a>
					</div>
					<div class="control">
						<button type="submit" class="button is-primary is-medium" disabled?={ !data.ProxmoxConnected }>
							<span class="icon"><i class="fas fa-save"></i></span>
							<span>{ T("VMDetails.SaveDescription") }</span>
						</button>
					</div>
				</div>
			</form>
		</div>
	</div>
}

templ vmDetailsTagsEditor(data VMDetailsData, T TranslationFunc) {
	<div class="card mb-5">
		<header class="card-header brand-header">
			<p class="card-header-title">
				<span class="icon-text">
					<span class="icon"><i class="fas fa-tags"></i></span>
					<span>{ T("VMDetails.EditTagsTitle") }</span>
				</span>
			</p>
		</header>
		<div class="card-content">
			<form action="/vm/update/tags" method="post">
				<input type="hidden" name="csrf_token" value={ data.CSRFToken }/>
				<input type="hidden" name="vmid" value={ strconv.Itoa(data.VM.VMID) }/>
				<input type="hidden" name="node" value={ data.VM.Node }/>
				<div class="field">
					<label class="label has-text-weight-semibold">{ T("VMDetails.AvailableTags") }</label>
					<div class="tags are-medium">
						<span class="tag is-primary is-medium">pvmss</span>
						<input type="hidden" name="tags" value="pvmss"/>
						for _, tag := range data.AvailableTags {
							if tag != "pvmss" {
								<label class="tag-checkbox-label">
									<input type="checkbox" name="tags" value={ tag } class="is-hidden" checked?={ vmDetailsTagSelected(data.Tags, tag) }/>
									<span class={ "tag", "is-light", "is-medium", vmDetailsTagClass(data.Tags, tag) }>{ tag }</span>
								</label>
							}
						}
					</div>
				</div>
				<hr class="my-4"/>
				<div class="field is-grouped is-justify-content-space-between">
					<div class="control">
						<a class="button is-light" href={ templ.SafeURL(fmt.Sprintf("/vm/details/%d", data.VM.VMID)) }>
							<span class="icon"><i class="fas fa-times"></i></span>
							<span>{ T("Common.Cancel") }</span>
						</a>
					</div>
					<div class="control">
						<button type="submit" class="button is-primary is-medium" disabled?={ !data.ProxmoxConnected }>
							<span class="icon"><i class="fas fa-save"></i></span>
							<span>{ T("VMDetails.SaveTags") }</span>
						</button>
					</div>
				</div>
			</form>
		</div>
	</div>
}

func vmDetailsTagClass(currentTags string, tag string) string {
	if vmDetailsTagSelected(currentTags, tag) {
		return "is-primary"
	}
	return ""
}

templ vmDetailsResourcesEditor(data VMDetailsData, T TranslationFunc) {
	<div class="card mb-5">
		<header class="card-header brand-header">
			<p class="card-header-title">
				<span class="icon-text">
					<span class="icon"><i class="fas fa-sliders"></i></span>
					<span>{ T("VMDetails.ModifyResources") }</span>
				</span>
			</p>
		</header>
		<div class="card-content">
			if data.VM.Status == "running" {
				@Notification(NotificationProps{
					Type:    NotificationDanger,
					Title:   T("VMDetails.ResourcesDisabledTitle"),
					Message: T("VMDetails.ResourcesDisabledMessage"),
					Icon:    "fas fa-exclamation-circle",
				})
			} else {
				@Notification(NotificationProps{
					Type:    NotificationInfo,
					Message: T("VMDetails.ResourcesWarningText"),
					Icon:    "fas fa-info-circle",
					Light:   true,
				})
			}
			<form action="/vm/update/resources" method="post">
				<input type="hidden" name="csrf_token" value={ data.CSRFToken }/>
				<input type="hidden" name="vmid" value={ strconv.Itoa(data.VM.VMID) }/>
				<input type="hidden" name="node" value={ data.VM.Node }/>
				<div class="columns is-multiline">
					<div class="column is-6">
						<div class="field">
							<label class="label">
								<span class="icon is-small"><i class="fas fa-microchip"></i></span>
								{ T("VMDetails.Label.Sockets") }
							</label>
							<div class="control">
								<div class="select is-medium is-fullwidth">
									<select name="sockets" required disabled?={ data.VM.Status == "running" }>
										for i := data.VMSocketsMin; i <= data.VMSocketsMax; i++ {
											<option value={ strconv.Itoa(i) } selected?={ i == vmDetailsGetCurrentSockets(data) }>{ strconv.Itoa(i) }</option>
										}
									</select>
								</div>
							</div>
						</div>
					</div>
					<div class="column is-6">
						<div class="field">
							<label class="label">
								<span class="icon is-small"><i class="fas fa-microchip"></i></span>
								{ T("VMDetails.Label.Cores") }
							</label>
							<div class="control">
								<div class="select is-medium is-fullwidth">
									<select name="cores" required disabled?={ data.VM.Status == "running" }>
										for i := data.VMCoresMin; i <= data.VMCoresMax; i++ {
											<option value={ strconv.Itoa(i) } selected?={ i == data.VM.CPUs }>{ strconv.Itoa(i) }</option>
										}
									</select>
								</div>
							</div>
						</div>
					</div>
					<div class="column is-12">
						<div class="field">
							<label class="label">
								<span class="icon is-small"><i class="fas fa-memory"></i></span>
								{ T("VMDetails.Label.RAM") }
							</label>
							<div class="field has-addons">
								<div class="control is-expanded">
									<input
										id="memory"
										class="input is-medium"
										type="number"
										name="memory"
										value={ strconv.FormatInt(data.VM.MaxMem/(1024*1024), 10) }
										min={ strconv.Itoa(data.VMRamMinMB) }
										max={ strconv.Itoa(data.VMRamMaxMB) }
										required
										disabled?={ data.VM.Status == "running" }
									/>
								</div>
								<div class="control">
									<div class="select is-medium">
										<select id="memory-unit" name="memory_unit" disabled?={ data.VM.Status == "running" }>
											<option value="MB">MB</option>
											<option value="GB">GB</option>
										</select>
									</div>
								</div>
							</div>
							<p class="help" id="memory-display">{ data.FormattedMaxMemGB }</p>
						</div>
					</div>
				</div>
				<hr class="my-4"/>
				<div class="field is-grouped is-justify-content-space-between">
					<div class="control">
						@Button(ButtonProps{
							Text: T("Common.Cancel"),
							Icon: "fas fa-times",
							Href: fmt.Sprintf("/vm/details/%d", data.VM.VMID),
							Type: ButtonLight,
						})
					</div>
					<div class="control">
						@Button(ButtonProps{
							Text:     T("Common.Save"),
							Icon:     "fas fa-save",
							Type:     ButtonPrimary,
							Size:     ButtonMedium,
							IsSubmit: true,
							Disabled: data.VM.Status == "running" || !data.ProxmoxConnected,
						})
					</div>
				</div>
			</form>
		</div>
	</div>
}

func vmDetailsGetCurrentSockets(data VMDetailsData) int {
	// CPUs in VM struct is total vCPUs (sockets * cores)
	// We need to calculate sockets from the current config
	// Default to 1 if we can't determine
	if data.VM.CPUs <= 0 {
		return 1
	}
	return 1 // Default, actual value comes from CurrentSockets in template data
}

templ vmDetailsSnapshotsCard(data VMDetailsData, T TranslationFunc) {
	<div class="card mb-5">
		<header class="card-header brand-header">
			<p class="card-header-title">
				<span class="icon-text">
					<span class="icon"><i class="fas fa-camera"></i></span>
					<span>{ T("VMDetails.Section.Snapshots") }</span>
				</span>
			</p>
		</header>
		<div class="card-content">
			if data.ProxmoxConnected && len(data.Snapshots) < data.MaxSnapshots {
				<form action="/vm/snapshot/create" method="post" class="mb-5">
					<input type="hidden" name="csrf_token" value={ data.CSRFToken }/>
					<input type="hidden" name="vmid" value={ strconv.Itoa(data.VM.VMID) }/>
					<input type="hidden" name="node" value={ data.VM.Node }/>
					<div class="columns is-multiline">
						<div class="column is-8">
							<div class="field">
								<label class="label">{ T("VMDetails.Snapshots.Name") }</label>
								<div class="control">
									<input name="snapshot_name" type="text" class="input" placeholder={ T("VMDetails.Snapshots.NamePlaceholder") } pattern="^[a-zA-Z0-9_-]+$" maxlength="40" required/>
								</div>
								<p class="help">{ T("VMDetails.Snapshots.NameHelp") }</p>
							</div>
						</div>
						<div class="column is-4">
							<div class="field">
								<label class="label">&nbsp;</label>
								<div class="control">
									<label class="checkbox">
										<input type="checkbox" name="vmstate" value="true"/>
										<span class="ml-2">{ T("VMDetails.Snapshots.IncludeRAM") }</span>
									</label>
								</div>
								<p class="help">{ T("VMDetails.Snapshots.IncludeRAMHelp") }</p>
							</div>
						</div>
						<div class="column is-12">
							<div class="field">
								<label class="label">{ T("VMDetails.Snapshots.Description") }</label>
								<div class="control">
									<textarea name="description" class="textarea" placeholder={ T("VMDetails.Snapshots.DescriptionPlaceholder") } maxlength="255" rows="2"></textarea>
								</div>
								<p class="help">{ T("Common.Optional") }</p>
							</div>
						</div>
						<div class="column is-12">
							<div class="field is-grouped">
								<div class="control">
									@Button(ButtonProps{
										Text:     T("VMDetails.Snapshots.Create"),
										Icon:     "fas fa-plus",
										Type:     ButtonPrimary,
										IsSubmit: true,
									})
								</div>
							</div>
						</div>
					</div>
				</form>
			} else if len(data.Snapshots) >= data.MaxSnapshots {
				<div class="notification is-warning is-light mb-4">
					<span class="icon"><i class="fas fa-exclamation-triangle"></i></span>
					<span>{ T("VMDetails.Snapshots.LimitReached") }</span>
				</div>
			}
			if len(data.Snapshots) > 0 {
				<div class="snapshot-list">
					for _, snap := range data.Snapshots {
						@vmDetailsSnapshotItem(snap, data, T)
					}
				</div>
			} else {
				<div class="has-text-centered" style="padding: 2rem 0;">
					<div class="has-text-grey-light" style="font-size: 3rem; margin-bottom: 1rem;">
						<i class="fas fa-camera"></i>
					</div>
					<div class="has-text-grey" style="font-size: 1.1rem; font-weight: 500;">
						{ T("VMDetails.Snapshots.Empty") }
					</div>
					<div class="has-text-grey-light" style="font-size: 0.9rem; margin-top: 0.5rem;">
						{ T("VMDetails.Snapshots.EmptyDescription") }
					</div>
				</div>
			}
		</div>
	</div>
}

templ vmDetailsSnapshotItem(snap SnapshotInfo, data VMDetailsData, T TranslationFunc) {
	<div class="snapshot-item" style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 1rem; margin-bottom: 0.75rem;">
		<div class="is-flex is-align-items-center is-justify-content-space-between">
			<div class="is-flex is-align-items-center" style="gap: 0.75rem;">
				<span class="icon has-text-primary">
					<i class="fas fa-camera"></i>
				</span>
				<div>
					<div class="has-text-weight-semibold">{ snap.Name }</div>
					if snap.Description != "" {
						<div class="has-text-grey is-size-7">{ snap.Description }</div>
					}
				</div>
				if snap.Vmstate == 1 {
					<span class="tag is-info is-light">
						<span class="icon is-small"><i class="fas fa-memory"></i></span>
						<span>{ T("VMDetails.Snapshots.WithRAM") }</span>
					</span>
				}
				if snap.Name == data.CurrentSnapshotName {
					<span class="tag is-success is-light">
						<span class="icon is-small"><i class="fas fa-check"></i></span>
						<span>{ T("VMDetails.Snapshots.Current") }</span>
					</span>
				}
			</div>
			if data.ProxmoxConnected {
				<form method="POST" action="/vm/snapshot/rollback" class="is-inline">
					<input type="hidden" name="csrf_token" value={ data.CSRFToken }/>
					<input type="hidden" name="vmid" value={ strconv.Itoa(data.VM.VMID) }/>
					<input type="hidden" name="node" value={ data.VM.Node }/>
					<input type="hidden" name="snapshot_name" value={ snap.Name }/>
					<button type="submit" class="button is-warning is-small" data-confirm={ T("VMDetails.Snapshots.ConfirmRollback") }>
						<span class="icon is-small"><i class="fas fa-undo"></i></span>
						<span class="is-hidden-mobile">{ T("VMDetails.Snapshots.Rollback") }</span>
					</button>
				</form>
				<form method="POST" action="/vm/snapshot/delete" class="is-inline">
					<input type="hidden" name="csrf_token" value={ data.CSRFToken }/>
					<input type="hidden" name="vmid" value={ strconv.Itoa(data.VM.VMID) }/>
					<input type="hidden" name="node" value={ data.VM.Node }/>
					<input type="hidden" name="snapshot_name" value={ snap.Name }/>
					<button type="submit" class="button is-danger is-small" data-confirm={ T("VMDetails.Snapshots.ConfirmDelete") }>
						<span class="icon is-small"><i class="fas fa-trash"></i></span>
						<span class="is-hidden-mobile">{ T("VMDetails.Snapshots.Delete") }</span>
					</button>
				</form>
			}
		</div>
	</div>
}

templ vmDetailsConsoleModal(data VMDetailsData, T TranslationFunc) {
	<div id="console-modal" class="modal">
		<div class="modal-background" onclick="closeConsoleModal()"></div>
		<div class="modal-card" style="width: 90vw; max-width: 1200px; height: 80vh;">
			<header class="modal-card-head">
				<p class="modal-card-title">
					<span class="icon-text">
						<span class="icon"><i class="fas fa-terminal"></i></span>
						<span>{ T("VMDetails.Console.Title") } - { data.VM.Name }</span>
					</span>
				</p>
				<button class="delete" aria-label="close" onclick="closeConsoleModal()"></button>
			</header>
			<section class="modal-card-body" style="padding: 0; overflow: hidden;">
				<iframe id="console-iframe" style="width: 100%; height: 100%; border: none;"></iframe>
			</section>
			<footer class="modal-card-foot is-justify-content-flex-end">
				<button class="button" onclick="closeConsoleModal()">{ T("Common.Close") }</button>
				<a id="console-fullscreen-link" href="#" target="_blank" class="button is-primary">
					<span class="icon is-small"><i class="fas fa-external-link-alt"></i></span>
					<span>{ T("VMDetails.Console.Fullscreen") }</span>
				</a>
			</footer>
		</div>
	</div>
}

templ vmDetailsScripts(data VMDetailsData, T TranslationFunc) {
	<script>
	var vmDetailsVMID = { strconv.Itoa(data.VM.VMID) };
	var vmDetailsNode = { templ.JSONString(data.VM.Node) };
	var vmDetailsStatus = { templ.JSONString(data.VM.Status) };
	</script>
}
