package components

import "fmt"

type AdminTagsData struct {
	Username    string
	Lang        string
	CSRFToken   string
	CurrentPath string
	Tags        []string
	TagCounts   map[string]int
}

type AdminTagDeleteData struct {
	Username  string
	Lang      string
	CSRFToken string
	Tag       string
}

templ AdminTagsPage(data AdminTagsData, T TranslationFunc) {
	@AdminLayout(AdminLayoutProps{
		Title:       T("Admin.Tags.Title"),
		Lang:        data.Lang,
		CurrentPath: "/admin/tags",
		Username:    data.Username,
		CSRFToken:   data.CSRFToken,
		Content:     adminTagsContent(data, T),
		T:           T,
	})
}

templ adminTagsContent(data AdminTagsData, T TranslationFunc) {
	@AdminPageHeader(T("Admin.Tags.Title"), "fas fa-tags", T("Admin.Tags.Description"), nil)
	<div class="box admin-box">
		<div class="toolbar mb-3">
			<form method="POST" action="/tags" class="is-flex is-align-items-center">
				<input type="hidden" name="csrf_token" value={ data.CSRFToken }/>
				<div class="field has-addons mb-0">
					<div class="control is-expanded">
						<input
							type="text"
							id="new-tag"
							name="tag"
							class="input is-medium"
							maxlength="50"
							placeholder={ T("Admin.Tags.Placeholder") }
							required
							pattern="[a-zA-Z0-9_\-]+"
							title={ T("Admin.Tags.ValidationMessage") }
						/>
					</div>
					<div class="control">
						@Button(ButtonProps{
							Text:     T("Admin.Tags.AddTag"),
							Icon:     "fas fa-plus",
							Type:     ButtonPrimary,
							Size:     ButtonMedium,
							IsSubmit: true,
						})
					</div>
				</div>
			</form>
		</div>
		if len(data.Tags) > 0 {
			<div class="table-container">
				<table class="table is-fullwidth modern">
					<thead>
						<tr>
							<th>
								<span class="icon-text">
									<span class="icon is-small"><i class="fas fa-tag"></i></span>
									<span>{ T("Admin.Tags.Header.Name") }</span>
								</span>
							</th>
							<th>{ T("Admin.Tags.Header.Usage") }</th>
							<th class="has-text-right">{ T("Common.Actions") }</th>
						</tr>
					</thead>
					<tbody>
						for _, tag := range data.Tags {
							<tr>
								<td>
									<span class="tag is-light">{ tag }</span>
								</td>
								<td>
									if count, ok := data.TagCounts[tag]; ok && count > 0 {
										<span class="tag is-success is-light">{ fmt.Sprintf("%d", count) } VMs</span>
									} else {
										<span class="tag is-light">0 VMs</span>
									}
								</td>
								<td class="has-text-right">
									if tag != "pvmss" {
										<a
											href={ templ.SafeURL("/admin/tags/delete?tag=" + tag) }
											class="button is-small is-danger is-light"
											title={ T("Admin.Tags.DeleteTag") + " \"" + tag + "\"" }
										>
											<span class="icon is-small"><i class="fas fa-trash"></i></span>
											<span>{ T("Common.Delete") }</span>
										</a>
									} else {
										<span class="tag is-light">{ T("Admin.Tags.DefaultTag") }</span>
									}
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		} else {
			@Notification(NotificationProps{
				Type:        NotificationInfo,
				Message:     T("Admin.Tags.NoTags"),
				Icon:        "fas fa-info-circle",
				Dismissible: true,
			})
		}
	</div>
}

templ AdminTagDeletePage(data AdminTagDeleteData, T TranslationFunc) {
	@AdminLayout(AdminLayoutProps{
		Title:       T("Admin.Tags.Title"),
		Lang:        data.Lang,
		CurrentPath: "/admin/tags",
		Username:    data.Username,
		CSRFToken:   data.CSRFToken,
		Content:     adminTagDeleteContent(data, T),
		T:           T,
	})
}

templ adminTagDeleteContent(data AdminTagDeleteData, T TranslationFunc) {
	@AdminPageHeader(T("Admin.Tags.Title"), "fas fa-tags", T("Admin.Tags.Description"), nil)
	<div class="box admin-box">
		@Notification(NotificationProps{
			Type:        NotificationWarning,
			Title:       T("Admin.Tags.DeleteConfirmTitle"),
			Message:     T("Admin.Tags.DeleteConfirmMessage"),
			Icon:        "fas fa-exclamation-triangle",
			Dismissible: true,
		})
		<div class="level">
			<div class="level-left">
				<div class="level-item">
					<span class="tag is-info is-large">{ data.Tag }</span>
				</div>
			</div>
			<div class="level-right">
				<div class="level-item">
					<form method="POST" action="/tags/delete" class="is-inline">
						<input type="hidden" name="csrf_token" value={ data.CSRFToken }/>
						<input type="hidden" name="tag" value={ data.Tag }/>
						<button type="submit" class="button is-danger has-text-white">
							<span class="icon"><i class="fas fa-trash"></i></span>
							<span>{ T("Common.Yes") }</span>
						</button>
					</form>
				</div>
				<div class="level-item">
					<a href="/admin/tags" class="button">
						<span class="icon"><i class="fas fa-times"></i></span>
						<span>{ T("Common.No") }</span>
					</a>
				</div>
			</div>
		</div>
	</div>
}
