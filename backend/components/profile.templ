package components

import (
	"fmt"
)

type ProfileVM struct {
	VMID         int
	Name         string
	Description  string
	DescriptionHTML string
	Node         string
	Status       string
}

type ProfileData struct {
	Username        string
	PoolName        string
	TotalVMs        int
	RunningVMs      int
	StoppedVMs      int
	HasVMs          bool
	VMs             []ProfileVM
	ProxmoxError    bool
	PasswordSuccess bool
	PasswordError   string
	ShowPasswordForm bool
	CSRFToken       string
	Lang            string
}

type TranslationFunc func(key string) string

templ ProfilePage(data ProfileData, T TranslationFunc) {
	@Layout(LayoutProps{
		Title:            T("Profile.Title"),
		Lang:             data.Lang,
		CurrentPath:      "/profile",
		IsAuthenticated:  true,
		IsAdmin:          false,
		Username:         data.Username,
		ProxmoxConnected: !data.ProxmoxError,
		CSRFToken:        data.CSRFToken,
		T:                T,
		Content:          profileContent(data, T),
	})
}

templ profileContent(data ProfileData, T TranslationFunc) {
	<section class="section">
		<div class="container">
			@profileHeader(T)
			@profileOverviewCard(data, T)
			@profileVMsCard(data, T)
			@profileSecurityCard(data, T)
		</div>
	</section>
	<script src="/js/profile-alpine.js"></script>
}

templ profileHeader(T TranslationFunc) {
	@PageHeader(PageHeaderProps{
		Title: T("Profile.Title"),
		Icon:  "fas fa-user-circle",
		Actions: profileHeaderActions(T),
	})
}

templ profileHeaderActions(T TranslationFunc) {
	<div class="buttons">
		@Button(ButtonProps{
			Text: T("Profile.CreateVM"),
			Icon: "fas fa-plus-square",
			Href: "/vm/create",
			Type: ButtonPrimary,
		})
		@Button(ButtonProps{
			Text:  T("Profile.SearchVM"),
			Icon:  "fas fa-search",
			Href:  "/search",
			Type:  ButtonLight,
		})
		@Button(ButtonProps{
			Text:  T("Common.Refresh"),
			Icon:  "fas fa-sync-alt",
			Href:  "/profile?refresh=1",
			Type:  ButtonLight,
			ID:    "profile-refresh-button",
			Title: T("Common.Refresh"),
		})
	</div>
}

templ profileOverviewCard(data ProfileData, T TranslationFunc) {
	<div class="card mb-5">
		<div class="card-content py-4 px-5">
			<div class="level is-mobile mb-3">
				<div class="level-left">
					<div class="level-item">
						<span class="icon has-text-primary mr-3" style="font-size: 2.25rem;">
							<i class="fas fa-user-circle"></i>
						</span>
						<div>
							<p class="title is-5 mb-1">{ data.Username }</p>
							<p class="is-size-7 has-text-grey">
								<span class="icon is-small has-text-info">
									<i class="fas fa-layer-group"></i>
								</span>
								<span class="has-text-weight-semibold">{ data.PoolName }</span>
							</p>
						</div>
					</div>
				</div>
				<div class="level-right">
					<div class="level-item">
						<span class="icon is-small has-text-primary mr-1">
							<i class="fas fa-chart-line"></i>
						</span>
						<span class="is-size-7 has-text-grey-dark has-text-weight-semibold">{ T("Profile.Overview") }</span>
					</div>
				</div>
			</div>
			<hr class="my-3" style="background-color: rgb(0,0,0,6%);"/>
			if data.HasVMs {
				@profileStats(data, T)
			} else {
				@profileEmptyStats(T)
			}
		</div>
	</div>
}

templ profileStats(data ProfileData, T TranslationFunc) {
	<div class="columns is-mobile is-variable is-1 has-text-centered" id="profile-stats-columns">
		<div class="column">
			<div class="py-2">
				<p class="heading is-size-7 mb-1 has-text-grey">{ T("Profile.TotalVMs") }</p>
				<p class="title is-4 mb-0 has-text-primary">
					<span x-text="stats.total">{ fmt.Sprintf("%d", data.TotalVMs) }</span>
				</p>
			</div>
		</div>
		<div class="column is-narrow px-0">
			<div class="py-2" style="border-left: 2px solid rgb(0,0,0,6%); height: 100%;"></div>
		</div>
		<div class="column">
			<div class="py-2">
				<p class="heading is-size-7 mb-1 has-text-grey">{ T("Profile.RunningVMs") }</p>
				<p class="title is-4 mb-0 has-text-success">
					<span x-text="stats.running">{ fmt.Sprintf("%d", data.RunningVMs) }</span>
				</p>
			</div>
		</div>
		<div class="column is-narrow px-0">
			<div class="py-2" style="border-left: 2px solid rgb(0,0,0,6%); height: 100%;"></div>
		</div>
		<div class="column">
			<div class="py-2">
				<p class="heading is-size-7 mb-1 has-text-grey">{ T("Profile.StoppedVMs") }</p>
				<p class="title is-4 mb-0 has-text-danger">
					<span x-text="stats.stopped">{ fmt.Sprintf("%d", data.StoppedVMs) }</span>
				</p>
			</div>
		</div>
	</div>
}

templ profileEmptyStats(T TranslationFunc) {
	<div class="has-text-centered py-3" id="profile-stats-empty">
		<span class="icon has-text-grey-lighter mb-2">
			<i class="fas fa-server fa-lg"></i>
		</span>
		<p class="is-size-7 has-text-grey">{ T("Profile.NoVMs") }</p>
	</div>
}

templ profileVMsCard(data ProfileData, T TranslationFunc) {
	<div class="card mb-5">
		<header class="card-header brand-header">
			<p class="card-header-title">
				<span class="icon-text">
					<span class="icon"><i class="fas fa-server"></i></span>
					<span>{ T("Profile.MyVMs") }</span>
				</span>
			</p>
		</header>
		<div class="card-content" id="profile-vms-card" data-has-error={ fmt.Sprintf("%t", data.ProxmoxError) } data-refresh-interval="4000">
			if data.ProxmoxError {
				@Notification(NotificationProps{
					Type:        NotificationWarning,
					Title:       T("Proxmox.ConnectionError"),
					Message:     T("Proxmox.NotConnected"),
					Icon:        "fas fa-exclamation-triangle",
					Dismissible: false,
				})
			} else {
				if data.HasVMs {
					@profileVMsWithData(data, T)
				} else {
					@profileVMsEmpty(T)
				}
			}
		</div>
	</div>
	@profileTranslations(T)
}

templ profileVMsWithData(data ProfileData, T TranslationFunc) {
	<div id="profile-vms-wrapper" x-data="profilePage()" x-init="init()">
		<div x-show="loading" class="has-text-centered py-4">
			<span class="icon"><i class="fas fa-spinner fa-spin"></i></span>
			<span class="ml-2">{ T("Common.Loading") }...</span>
		</div>
		<div x-show="error" class="notification is-danger">
			<button class="delete" @click="error = null"></button>
			<span x-text="error"></span>
		</div>
		<template x-if="!loading && !error">
			@profileVMsTableAlpine(data.VMs, T)
		</template>
	</div>
}

templ profileVMsTableAlpine(vms []ProfileVM, T TranslationFunc) {
	<div class="table-container" id="profile-vm-table-container">
		<table class="table is-fullwidth">
			<thead>
				<tr class="has-background-light">
					<th class="has-text-centered" width="100">
						<span>{ T("Profile.VMID") }</span>
					</th>
					<th>
						<span>{ T("Profile.VMName") }</span>
					</th>
					<th>
						<span>{ T("Profile.Description") }</span>
					</th>
					<th class="has-text-centered" width="150">
						<span>{ T("Profile.Node") }</span>
					</th>
					<th class="has-text-centered" width="150">
						<span>{ T("Profile.Status") }</span>
					</th>
					<th class="has-text-centered" width="280">
						<span>{ T("Profile.VMManagement") }</span>
					</th>
				</tr>
			</thead>
			<tbody>
				<template x-for="vm in vms" :key="vm.vmid">
					<tr class="is-size-6">
						<td class="has-text-centered is-vcentered">
							<span class="tag is-light is-medium has-text-weight-bold" x-text="vm.vmid"></span>
						</td>
						<td class="is-vcentered">
							<div class="is-flex is-align-items-center">
								<span x-show="vm.name" class="has-text-weight-semibold" x-text="vm.name || ''"></span>
								<em x-show="!vm.name" class="has-text-grey-light">{ T("Profile.NoName") }</em>
							</div>
						</td>
						<td class="is-vcentered">
							<div x-show="vm.description" x-html="formatMarkdown(vm.description || '')"></div>
							<em x-show="!vm.description" class="has-text-grey-light">{ T("Profile.NoDescription") }</em>
						</td>
						<td class="has-text-centered is-vcentered">
							<span class="tag is-light" x-text="vm.node || ''"></span>
						</td>
						<td class="has-text-centered is-vcentered">
							<span :class="'tag is-' + getStatusClass(vm.status)" x-text="vm.status || ''"></span>
						</td>
						<td class="has-text-centered is-vcentered">
							<div class="buttons is-centered">
								<a :href="'/vm/details/' + vm.vmid" class="button is-primary">
									<span class="icon"><i class="fas fa-eye"></i></span>
									<span>{ T("Profile.ViewDetails") }</span>
								</a>
							</div>
						</td>
					</tr>
				</template>
			</tbody>
		</table>
	</div>
}

templ profileVMsTable(vms []ProfileVM, T TranslationFunc) {
	<div class="table-container" id="profile-vm-table-container">
		<table class="table is-fullwidth">
			<thead>
				<tr class="has-background-light">
					<th class="has-text-centered" width="100">
						<span>{ T("Profile.VMID") }</span>
					</th>
					<th>
						<span>{ T("Profile.VMName") }</span>
					</th>
					<th>
						<span>{ T("Profile.Description") }</span>
					</th>
					<th class="has-text-centered" width="150">
						<span>{ T("Profile.Node") }</span>
					</th>
					<th class="has-text-centered" width="150">
						<span>{ T("Profile.Status") }</span>
					</th>
					<th class="has-text-centered" width="280">
						<span>{ T("Profile.VMManagement") }</span>
					</th>
				</tr>
			</thead>
			<tbody id="profile-vm-table-body">
				for _, vm := range vms {
					<tr class="is-size-6">
						<td class="has-text-centered is-vcentered">
							<span class="tag is-light is-medium has-text-weight-bold">{ fmt.Sprintf("%d", vm.VMID) }</span>
						</td>
						<td class="is-vcentered">
							<div class="is-flex is-align-items-center">
								if vm.Name != "" {
									<span class="has-text-weight-semibold">{ vm.Name }</span>
								} else {
									<em class="has-text-grey-light">{ T("Profile.NoName") }</em>
								}
							</div>
						</td>
						<td class="is-vcentered">
							if vm.Description != "" {
								<span class="is-size-7" templ.HTML={ vm.DescriptionHTML }></span>
							} else {
								<em class="has-text-grey-light is-size-7">{ T("Profile.NoDescription") }</em>
							}
						</td>
						<td class="has-text-centered is-vcentered">
							<span class="tag is-small">{ vm.Node }</span>
						</td>
						<td class="has-text-centered is-vcentered">
							@StatusBadge(StatusBadgeProps{
								Status:   VMStatus(vm.Status),
								WithIcon: true,
							})
						</td>
						<td class="has-text-centered is-vcentered">
							<div class="buttons is-centered mb-0">
								<a href={ templ.SafeURL(fmt.Sprintf("/vm/details/%d", vm.VMID)) } class="button is-primary" title={ T("Profile.ViewDetails") }>
									<span class="icon"><i class="fas fa-eye"></i></span>
									<span>{ T("Profile.ViewDetails") }</span>
								</a>
								<a href={ templ.SafeURL(fmt.Sprintf("/vm/delete/%d", vm.VMID)) } class="button is-danger" title={ T("Profile.Delete") }>
									<span class="icon"><i class="fas fa-trash-alt"></i></span>
									<span>{ T("Profile.Delete") }</span>
								</a>
							</div>
						</td>
					</tr>
				}
			</tbody>
		</table>
	</div>
}

templ profileVMsEmpty(T TranslationFunc) {
	<div id="profile-vm-empty-state">
		<div class="has-text-centered py-6">
			<span class="icon has-text-grey-lighter mb-4" style="font-size: 3rem;">
				<i class="fas fa-inbox"></i>
			</span>
			<p class="title is-5 has-text-grey">{ T("Profile.NoVMs") }</p>
			<p class="subtitle is-6 has-text-grey-light">{ T("Profile.NoVMsMessage") }</p>
			<div class="buttons is-centered mt-4">
				@Button(ButtonProps{
					Text: T("Profile.CreateFirstVM"),
					Icon: "fas fa-plus",
					Href: "/vm/create",
					Type: ButtonPrimary,
				})
			</div>
		</div>
	</div>
}

templ profileTranslations(T TranslationFunc) {
	<div
		id="profile-translations"
		data-status-running={ T("Status.Running") }
		data-status-stopped={ T("Status.Stopped") }
		data-status-paused={ T("Status.Paused") }
		data-status-unknown={ T("Status.Unknown") }
		data-view-details={ T("Profile.ViewDetails") }
		data-delete={ T("Profile.Delete") }
		data-no-description={ T("Profile.NoDescription") }
		data-no-name={ T("Profile.NoName") }
		class="is-hidden"
		aria-hidden="true"
	></div>
}

templ profileSecurityCard(data ProfileData, T TranslationFunc) {
	<div class="card">
		<header class="card-header brand-header">
			<p class="card-header-title is-size-6">
				<span class="icon-text">
					<span class="icon"><i class="fas fa-shield-halved"></i></span>
					<span>{ T("Profile.Security") }</span>
				</span>
			</p>
		</header>
		<div class="card-content py-4">
			if data.PasswordSuccess {
				@Notification(NotificationProps{
					Type:        NotificationSuccess,
					Message:     T("Profile.PasswordUpdateSuccess"),
					Icon:        "fas fa-check-circle",
					Dismissible: true,
				})
			}
			if data.PasswordError != "" {
				@Notification(NotificationProps{
					Type:        NotificationDanger,
					Message:     data.PasswordError,
					Icon:        "fas fa-exclamation-triangle",
					Dismissible: true,
				})
			}
			if data.ShowPasswordForm {
				@profilePasswordForm(data.CSRFToken, T)
			} else {
				@profilePasswordButton(T)
			}
		</div>
	</div>
}

templ profilePasswordForm(csrfToken string, T TranslationFunc) {
	<div class="columns is-variable is-5">
		<div class="column is-12-tablet is-4-desktop">
			<div class="box has-background-light has-text-centered py-4 px-3">
				<span class="icon has-text-warning mb-2" style="font-size: 2rem;">
					<i class="fas fa-key"></i>
				</span>
				<p class="title is-6 mb-2">{ T("Profile.ChangePassword") }</p>
				<p class="is-size-7 has-text-grey-dark">{ T("Profile.ChangePasswordDescription") }</p>
			</div>
		</div>
		<div class="column is-12-tablet is-8-desktop">
			<form method="POST" action="/profile/update-password" class="box py-4">
				<input type="hidden" name="csrf_token" value={ csrfToken }/>
				<div class="field">
					<label class="label is-size-7 has-text-weight-semibold">
						<span class="icon-text">
							<span class="icon is-small has-text-grey"><i class="fas fa-lock"></i></span>
							<span>{ T("Profile.CurrentPassword") }</span>
						</span>
					</label>
					<div class="control has-icons-left">
						<input
							class="input is-small"
							type="password"
							name="current_password"
							placeholder={ T("Profile.CurrentPasswordPlaceholder") }
							required
							minlength="5"
							autofocus
						/>
						<span class="icon is-small is-left"><i class="fas fa-lock"></i></span>
					</div>
				</div>
				<div class="field">
					<label class="label is-size-7 has-text-weight-semibold">
						<span class="icon-text">
							<span class="icon is-small has-text-grey"><i class="fas fa-key"></i></span>
							<span>{ T("Profile.NewPassword") }</span>
						</span>
					</label>
					<div class="control has-icons-left">
						<input
							class="input is-small"
							type="password"
							name="new_password"
							placeholder={ T("Profile.NewPasswordPlaceholder") }
							required
							minlength="5"
						/>
						<span class="icon is-small is-left"><i class="fas fa-key"></i></span>
					</div>
				</div>
				<div class="field">
					<label class="label is-size-7 has-text-weight-semibold">
						<span class="icon-text">
							<span class="icon is-small has-text-grey"><i class="fas fa-check-double"></i></span>
							<span>{ T("Profile.ConfirmPassword") }</span>
						</span>
					</label>
					<div class="control has-icons-left">
						<input
							class="input is-small"
							type="password"
							name="confirm_password"
							placeholder={ T("Profile.ConfirmPasswordPlaceholder") }
							required
							minlength="5"
						/>
						<span class="icon is-small is-left"><i class="fas fa-check"></i></span>
					</div>
				</div>
				<hr class="my-3"/>
				<div class="field is-grouped is-grouped-right">
					<div class="control">
						<a href="/profile" class="button is-light">
							<span class="icon"><i class="fas fa-times"></i></span>
							<span>{ T("Common.Cancel") }</span>
						</a>
					</div>
					<div class="control">
						<button type="submit" class="button is-primary">
							<span class="icon"><i class="fas fa-check"></i></span>
							<span>{ T("Profile.UpdatePassword") }</span>
						</button>
					</div>
				</div>
			</form>
		</div>
	</div>
}

templ profilePasswordButton(T TranslationFunc) {
	<div class="level">
		<div class="level-left">
			<div class="level-item">
				<span class="icon has-text-warning mr-3" style="font-size: 1.75rem;">
					<i class="fas fa-key"></i>
				</span>
				<div>
					<p class="title is-6 mb-1">{ T("Profile.ChangePassword") }</p>
					<p class="is-size-7 has-text-grey">{ T("Profile.PasswordChangeDescription") }</p>
				</div>
			</div>
		</div>
		<div class="level-right">
			<div class="level-item">
				<a href="/profile?show_password_form=1" class="button is-primary">
					<span class="icon"><i class="fas fa-edit"></i></span>
					<span>{ T("Profile.ChangePasswordButton") }</span>
				</a>
			</div>
		</div>
	</div>
}
