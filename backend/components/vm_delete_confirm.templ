package components

import "fmt"

type VMDeleteData struct {
	VMID       int
	Name       string
	Node       string
	Status     string
	CSRFToken  string
	Username   string
	Lang       string
}

templ VMDeleteConfirmPage(data VMDeleteData, T TranslationFunc) {
	@Layout(LayoutProps{
		Title:            T("VMDelete.ConfirmTitle"),
		Lang:             data.Lang,
		CurrentPath:      "",
		IsAuthenticated:  true,
		IsAdmin:          false,
		Username:         data.Username,
		ProxmoxConnected: true,
		CSRFToken:        data.CSRFToken,
		T:                T,
		Content:          vmDeleteConfirmContent(data, T),
	})
}

templ vmDeleteConfirmContent(data VMDeleteData, T TranslationFunc) {
	<section class="section">
		<div class="container max-w-1200" style="max-width: 800px;">
			<div class="card">
				<header class="card-header is-danger">
					<p class="card-header-title has-text-white">
						<span class="icon"><i class="fas fa-exclamation-triangle"></i></span>&nbsp;{ T("VMDelete.ConfirmTitle") }
					</p>
				</header>
				<div class="card-content">
					@Notification(NotificationProps{
						Type:  NotificationDanger,
						Title: T("VMDelete.ConfirmMessage"),
						Icon:  "fas fa-trash-alt",
						Light: true,
						Class: "mb-0",
					})
					<div class="box has-background-white my-4">
						<div class="columns is-mobile is-multiline">
							<div class="column is-6">
								<p class="has-text-grey is-size-7 mb-1">VM ID</p>
								<p class="is-size-5 has-text-weight-semibold">{ fmt.Sprintf("%d", data.VMID) }</p>
							</div>
							<div class="column is-6">
								<p class="has-text-grey is-size-7 mb-1">{ T("Common.Name") }</p>
								<p class="is-size-5 has-text-weight-semibold">{ data.Name }</p>
							</div>
							<div class="column is-6">
								<p class="has-text-grey is-size-7 mb-1">{ T("Common.Node") }</p>
								<p class="is-size-5 has-text-weight-semibold">{ data.Node }</p>
							</div>
							<div class="column is-6">
								<p class="has-text-grey is-size-7 mb-1">{ T("Common.Status") }</p>
								@StatusBadge(StatusBadgeProps{
									Status:   VMStatus(data.Status),
									WithIcon: false,
								})
							</div>
						</div>
					</div>
					<div class="content">
						<h3 class="title is-6 has-text-danger">{ T("VMDelete.WarningTitle") }</h3>
						<ul>
							<li>{ T("VMDelete.Warning1") }</li>
							<li>{ T("VMDelete.Warning2") }</li>
							<li>{ T("VMDelete.Warning3") }</li>
						</ul>
						<p class="has-text-weight-bold mt-4">{ T("VMDelete.Question") }</p>
					</div>
					<div class="buttons is-justify-content-space-between mt-5">
						<a href={ templ.SafeURL(fmt.Sprintf("/vm/details/%d?refresh=1", data.VMID)) } class="button is-medium">
							<span class="icon"><i class="fas fa-arrow-left"></i></span>
							<span>{ T("Common.No") }</span>
						</a>
						<form action="/vm/delete" method="post" class="is-inline">
							<input type="hidden" name="csrf_token" value={ data.CSRFToken }/>
							<input type="hidden" name="vmid" value={ fmt.Sprintf("%d", data.VMID) }/>
							<input type="hidden" name="node" value={ data.Node }/>
							<button type="submit" class="button is-danger is-medium">
								<span class="icon"><i class="fas fa-trash-alt"></i></span>
								<span>{ T("Common.Yes") }</span>
							</button>
						</form>
					</div>
				</div>
			</div>
			<div class="content has-text-centered mt-5">
				<p class="has-text-grey is-size-7">
					<span class="icon"><i class="fas fa-info-circle"></i></span>
					{ T("VMDelete.BackInfo") }
				</p>
			</div>
		</div>
	</section>
}
