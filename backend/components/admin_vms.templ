package components

import (
	"fmt"
	"strings"
)

type AdminVMInfo struct {
	VMID   int
	Name   string
	Node   string
	Status string
	Tags   string
}

func (v AdminVMInfo) TagsList() []string {
	if v.Tags == "" {
		return nil
	}
	return strings.Split(v.Tags, ";")
}

type PaginationInfo struct {
	From int
	To   int
}

type AdminVMsData struct {
	Username        string
	Lang            string
	CSRFToken       string
	VMs             []AdminVMInfo
	TotalVMs        int
	CurrentPage     int
	TotalPages      int
	Limit           int
	HasPrevPage     bool
	HasNextPage     bool
	PrevPage        int
	NextPage        int
	PaginationPages []int
	PaginationInfo  PaginationInfo
}

templ AdminVMsPage(data AdminVMsData, T TranslationFunc) {
	@AdminLayout(AdminLayoutProps{
		Title:       T("AdminVMs.Title"),
		Lang:        data.Lang,
		CurrentPath: "/admin/vms",
		Username:    data.Username,
		CSRFToken:   data.CSRFToken,
		Content:     adminVMsContent(data, T),
		T:           T,
	})
}

templ adminVMsContent(data AdminVMsData, T TranslationFunc) {
	@AdminPageHeader(T("AdminVMs.Title"), "fas fa-server", T("AdminVMs.Description"), nil)
	<div class="box admin-box">
		if len(data.VMs) > 0 {
			<div class="level mb-4">
				<div class="level-left">
					<div class="level-item">
						<span class="tag is-info is-light is-medium">
							<span class="icon"><i class="fas fa-list"></i></span>
							<span>Total: { fmt.Sprintf("%d", data.TotalVMs) } VM{ pluralS(data.TotalVMs) }</span>
						</span>
					</div>
				</div>
				<div class="level-right">
					<div class="level-item">
						<a href="/search" class="button is-primary">
							<span class="icon"><i class="fas fa-magnifying-glass"></i></span>
							<span>{ T("Search.Title") }</span>
						</a>
					</div>
				</div>
			</div>
			<div class="table-container">
				<table class="table is-fullwidth modern">
					<thead>
						<tr>
							<th class="has-text-centered">
								<span class="icon-text">
									<span class="icon is-small"><i class="fas fa-hashtag"></i></span>
									<span>{ T("Search.VMID") }</span>
								</span>
							</th>
							<th class="has-text-centered">
								<span class="icon-text">
									<span class="icon is-small"><i class="fas fa-tag"></i></span>
									<span>{ T("Search.Name") }</span>
								</span>
							</th>
							<th class="has-text-centered">
								<span class="icon-text">
									<span class="icon is-small"><i class="fas fa-server"></i></span>
									<span>{ T("Search.Node") }</span>
								</span>
							</th>
							<th class="has-text-centered">
								<span class="icon-text">
									<span class="icon is-small"><i class="fas fa-circle-info"></i></span>
									<span>{ T("Search.Status") }</span>
								</span>
							</th>
							<th class="has-text-centered">
								<span class="icon-text">
									<span class="icon is-small"><i class="fas fa-tags"></i></span>
									<span>{ T("Search.Tags") }</span>
								</span>
							</th>
							<th class="has-text-centered">
								<span class="icon-text">
									<span class="icon is-small"><i class="fas fa-wrench"></i></span>
									<span>{ T("Common.Actions") }</span>
								</span>
							</th>
						</tr>
					</thead>
					<tbody>
						for _, vm := range data.VMs {
							@adminVMRow(vm, T)
						}
					</tbody>
				</table>
			</div>
			if data.TotalVMs > 0 {
				@vmsPagination(data, T)
			}
		} else {
			@Notification(NotificationProps{
				Type:    NotificationInfo,
				Title:   T("Admin.VMs.NoVMsTitle"),
				Message: T("Admin.VMs.NoVMsMessage"),
				Icon:    "fas fa-info-circle",
			})
		}
	</div>
	<script>
		document.addEventListener('DOMContentLoaded', function() {
			const limitSelector = document.getElementById('limitSelector');
			if (limitSelector) {
				limitSelector.addEventListener('change', function() {
					const limit = this.value;
					const currentUrl = new URL(window.location);
					currentUrl.searchParams.set('page', '1');
					currentUrl.searchParams.set('limit', limit);
					window.location.href = currentUrl.pathname + currentUrl.search;
				});
			}
		});
	</script>
}

func pluralS(n int) string {
	if n != 1 {
		return "s"
	}
	return ""
}

templ adminVMRow(vm AdminVMInfo, T TranslationFunc) {
	<tr>
		<td class="has-text-centered has-text-weight-semibold">
			{ fmt.Sprintf("%d", vm.VMID) }
		</td>
		<td class="has-text-centered">
			{ vm.Name }
		</td>
		<td class="has-text-centered">
			<span class="tag is-light">{ vm.Node }</span>
		</td>
		<td class="has-text-centered">
			@vmStatusBadge(vm.Status)
		</td>
		<td class="has-text-centered">
			if len(vm.TagsList()) > 0 {
				for _, tag := range vm.TagsList() {
					if tag != "" {
						<span class="tag is-info is-light mr-1">{ tag }</span>
					}
				}
			} else {
				<span class="tag is-light">-</span>
			}
		</td>
		<td class="has-text-centered">
			<a href={ templ.SafeURL(fmt.Sprintf("/vm/details/%d", vm.VMID)) } class="button is-primary" title={ T("Search.Details") }>
				<span class="icon is-small"><i class="fas fa-eye"></i></span>
				<span>{ T("Search.Details") }</span>
			</a>
		</td>
	</tr>
}

templ vmStatusBadge(status string) {
	if status == "running" {
		<span class="tag is-success">running</span>
	} else if status == "stopped" {
		<span class="tag is-warning">stopped</span>
	} else {
		<span class="tag is-light">{ status }</span>
	}
}

templ vmsPagination(data AdminVMsData, T TranslationFunc) {
	<nav class="pagination is-centered mt-4" role="navigation" aria-label="pagination">
		if data.HasPrevPage {
			<a href={ templ.SafeURL(fmt.Sprintf("/admin/vms?page=%d&limit=%d", data.PrevPage, data.Limit)) } class="pagination-previous">
				<span class="icon"><i class="fas fa-chevron-left"></i></span>
				<span>{ T("Common.Previous") }</span>
			</a>
		} else {
			<span class="pagination-previous" disabled="disabled">
				<span class="icon"><i class="fas fa-chevron-left"></i></span>
				<span>{ T("Common.Previous") }</span>
			</span>
		}
		if data.HasNextPage {
			<a href={ templ.SafeURL(fmt.Sprintf("/admin/vms?page=%d&limit=%d", data.NextPage, data.Limit)) } class="pagination-next">
				<span>{ T("Common.Next") }</span>
				<span class="icon"><i class="fas fa-chevron-right"></i></span>
			</a>
		} else {
			<span class="pagination-next" disabled="disabled">
				<span>{ T("Common.Next") }</span>
				<span class="icon"><i class="fas fa-chevron-right"></i></span>
			</span>
		}
		if data.TotalPages > 1 {
			<ul class="pagination-list">
				<li><span class="pagination-ellipsis">&nbsp;</span></li>
				for _, page := range data.PaginationPages {
					<li>
						if page == data.CurrentPage {
							<span class="pagination-link is-current" aria-current="page">{ fmt.Sprintf("%d", page) }</span>
						} else {
							<a href={ templ.SafeURL(fmt.Sprintf("/admin/vms?page=%d&limit=%d", page, data.Limit)) } class="pagination-link">{ fmt.Sprintf("%d", page) }</a>
						}
					</li>
				}
				<li><span class="pagination-ellipsis">&nbsp;</span></li>
			</ul>
		}
	</nav>
	<div class="level mt-3">
		<div class="level-left">
			<div class="level-item">
				<small class="has-text-grey">
					{ T("Common.Showing") } { fmt.Sprintf("%d", data.PaginationInfo.From) } { T("Common.To") } { fmt.Sprintf("%d", data.PaginationInfo.To) } { T("Common.Of") } { fmt.Sprintf("%d", data.TotalVMs) } { T("Common.VMs") } ({ T("Common.Page") } { fmt.Sprintf("%d", data.CurrentPage) }
					if data.TotalPages > 1 {
						{ T("Common.Of") } { fmt.Sprintf("%d", data.TotalPages) }
					}
					)
				</small>
			</div>
		</div>
		<div class="level-right">
			<div class="level-item">
				<div class="field">
					<div class="control">
						<div class="select is-small">
							<select id="limitSelector">
								<option value="10" selected?={ data.Limit == 10 }>10 { T("Common.PerPage") }</option>
								<option value="25" selected?={ data.Limit == 25 }>25 { T("Common.PerPage") }</option>
								<option value="50" selected?={ data.Limit == 50 }>50 { T("Common.PerPage") }</option>
								<option value="100" selected?={ data.Limit == 100 }>100 { T("Common.PerPage") }</option>
							</select>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
}
