package components

import "fmt"

type NodeDetail struct {
	Node      string
	Status    string
	CPU       float64
	MaxCPU    int
	Memory    float64
	MaxMemory float64
	Disk      float64
	MaxDisk   float64
}

type AdminNodesData struct {
	Username            string
	Lang                string
	CSRFToken           string
	CurrentPath         string
	ProxmoxConnected    bool
	Error               string
	NodeDetails         []NodeDetail
	NodeCacheAgeSeconds int
	NodeLastUpdate      map[string]string
}

func (n NodeDetail) CPUPercent() float64 {
	return n.CPU * 100.0
}

func (n NodeDetail) MemoryPercent() float64 {
	if n.MaxMemory == 0 {
		return 0
	}
	return (n.Memory / n.MaxMemory) * 100.0
}

func (n NodeDetail) DiskPercent() float64 {
	if n.MaxDisk == 0 {
		return 0
	}
	return (n.Disk / n.MaxDisk) * 100.0
}

func (n NodeDetail) IsOfflineNoMetrics() bool {
	return n.Status == "offline" && n.MaxCPU == 0 && n.MaxMemory == 0 && n.MaxDisk == 0
}

// progressClass and formatBytes are now in helpers.templ as ProgressClass and FormatBytes

templ AdminNodesPage(data AdminNodesData, T TranslationFunc) {
	@AdminLayout(AdminLayoutProps{
		Title:       T("Nodes.Title"),
		Lang:        data.Lang,
		CurrentPath: "/admin/nodes",
		Username:    data.Username,
		CSRFToken:   data.CSRFToken,
		Content:     adminNodesContent(data, T),
		T:           T,
	})
}

templ adminNodesContent(data AdminNodesData, T TranslationFunc) {
	if !data.ProxmoxConnected {
		@ProxmoxOfflineWarning(T)
	} else if data.Error != "" {
		@ErrorNotification(data.Error, T)
	} else if len(data.NodeDetails) > 0 {
		@AdminPageHeader(T("Nodes.Title"), "fas fa-server", T("Nodes.Description"), nil)
		if data.NodeCacheAgeSeconds > 0 {
			<p class="is-size-7 has-text-grey mb-4">
				<span class="icon is-small"><i class="fas fa-clock"></i></span>
				<span>{ T("Nodes.DataAgePrefix") } { fmt.Sprintf("%d", data.NodeCacheAgeSeconds) }s</span>
			</p>
		}
		<div class="columns is-multiline">
			for _, node := range data.NodeDetails {
				<div class="column is-12-mobile is-6-tablet is-4-desktop">
					@nodeCard(node, data.NodeLastUpdate, T)
				</div>
			}
		</div>
	} else {
		@EmptyState(EmptyStateProps{
			Icon:        "fas fa-server",
			Title:       T("Nodes.NoNodes"),
			Description: T("Admin.SelectSectionPrompt"),
		})
	}
	<script>
		setInterval(function() {
			window.location.reload();
		}, 30000);
	</script>
}

templ nodeCard(node NodeDetail, lastUpdate map[string]string, T TranslationFunc) {
	<div class="card node-card">
		<header class="card-header">
			<p class="card-header-title">
				<span class="icon mr-2"><i class="fas fa-server"></i></span>
				<span>{ node.Node }</span>
			</p>
		</header>
		<div class="card-content">
			<div class="is-flex is-justify-content-space-between is-align-items-center mb-3">
				<div>
					@nodeStatusTag(node.Status, T)
				</div>
			@Button(ButtonProps{
				Icon:       "fas fa-sync-alt",
				Type:       ButtonLight,
				Title:      T("Nodes.RefreshNode"),
				AriaLabel:  T("Nodes.RefreshNode"),
				FormAction: "/admin/nodes",
				FormMethod: "GET",
				HiddenInputs: map[string]string{
					"refreshNode": node.Node,
				},
			})
			</div>
			if node.IsOfflineNoMetrics() {
				<div class="notification is-warning is-light">
					<span class="icon"><i class="fas fa-exclamation-triangle"></i></span>
					<span>{ T("Nodes.OfflineMessage") }</span>
				</div>
				<div class="has-text-centered is-size-7 has-text-grey">
					<span class="icon is-small"><i class="fas fa-info-circle"></i></span>
					<span>{ T("Nodes.OfflineInfo") }</span>
				</div>
			} else {
				if node.Status == "offline" {
					<p class="is-size-7 has-text-grey mb-2">
						<span class="icon is-small"><i class="fas fa-history"></i></span>
						<span>{ T("Nodes.LastKnownMetrics") }</span>
					</p>
				}
				@nodeMetricCPU(node, T)
				@nodeMetricMemory(node, T)
				@nodeMetricDisk(node, T)
			}
			if last, ok := lastUpdate[node.Node]; ok && last != "" {
				<div class="is-size-7 has-text-grey mt-3">
					<span class="icon is-small"><i class="fas fa-clock"></i></span>
					<span>{ T("Nodes.NodeLastUpdatePrefix") } { last }</span>
				</div>
			}
		</div>
	</div>
}

templ nodeStatusTag(status string, T TranslationFunc) {
	if status == "online" {
		<span class="tag is-success is-light">
			<span class="icon is-small"><i class="fas fa-circle"></i></span>
			<span class="ml-1">{ T("Nodes.Status.Online") }</span>
		</span>
	} else if status == "offline" {
		<span class="tag is-danger is-light">
			<span class="icon is-small"><i class="fas fa-circle"></i></span>
			<span class="ml-1">{ T("Nodes.Status.Offline") }</span>
		</span>
	} else {
		<span class="tag is-warning is-light">
			<span class="icon is-small"><i class="fas fa-question-circle"></i></span>
			<span class="ml-1">{ status }</span>
		</span>
	}
}

templ nodeMetricCPU(node NodeDetail, T TranslationFunc) {
	<div class="field mb-4">
		<label class="label is-small has-text-grey">
			<span class="icon is-small"><i class="fas fa-microchip"></i></span>
			<span>{ T("Nodes.Header.CPUUsage") }</span>
		</label>
		<div class="control">
			<progress
				class={ "progress is-small", ProgressClass(node.CPUPercent()) }
				value={ fmt.Sprintf("%.0f", node.CPUPercent()) }
				max="100"
			></progress>
		</div>
		<div class="is-flex is-justify-content-space-between is-size-7">
			<span class="has-text-weight-bold">{ fmt.Sprintf("%.1f%%", node.CPUPercent()) }</span>
		</div>
	</div>
}

templ nodeMetricMemory(node NodeDetail, T TranslationFunc) {
	<div class="field mb-4">
		<label class="label is-small has-text-grey">
			<span class="icon is-small"><i class="fas fa-memory"></i></span>
			<span>{ T("Nodes.Header.MemoryUsage") }</span>
		</label>
		<div class="control">
			<progress
				class={ "progress is-small", ProgressClass(node.MemoryPercent()) }
				value={ fmt.Sprintf("%.0f", node.MemoryPercent()) }
				max="100"
			></progress>
		</div>
		<div class="is-flex is-justify-content-space-between is-size-7">
			<span>{ FormatBytes(node.Memory) } / { FormatBytes(node.MaxMemory) }</span>
			<span class="has-text-weight-bold">{ fmt.Sprintf("%.0f%%", node.MemoryPercent()) }</span>
		</div>
	</div>
}

templ nodeMetricDisk(node NodeDetail, T TranslationFunc) {
	<div class="field">
		<label class="label is-small has-text-grey">
			<span class="icon is-small"><i class="fas fa-hdd"></i></span>
			<span>{ T("Nodes.Header.DiskUsage") }</span>
		</label>
		<div class="control">
			<progress
				class={ "progress is-small", ProgressClass(node.DiskPercent()) }
				value={ fmt.Sprintf("%.0f", node.DiskPercent()) }
				max="100"
			></progress>
		</div>
		<div class="is-flex is-justify-content-space-between is-size-7">
			<span>{ FormatBytes(node.Disk) } / { FormatBytes(node.MaxDisk) }</span>
			<span class="has-text-weight-bold">{ fmt.Sprintf("%.0f%%", node.DiskPercent()) }</span>
		</div>
	</div>
}
