templ vmActionRefreshButton(props VMActionButtonsProps, T TranslationFunc) {
	<a href={ templ.SafeURL(fmt.Sprintf("/vm/details/%d?refresh=1", props.VMID)) } class="button is-light vm-refresh-button">
		<span class="icon"><i class="fas fa-sync-alt"></i></span>
		<span class="button-text">{ T("VMDetails.Action.Refresh") }</span>
		<span class="button-loading is-hidden">
