package components

import (
	"fmt"
	"strconv"
)

type VMActionButtonsProps struct {
	VMID             int
	Node             string
	Status           string
	CSRFToken        string
	ProxmoxConnected bool
	ExtraClasses     string
	Actions          []string
}

func getDefaultActions() []string {
	return []string{"start", "console", "reboot", "shutdown", "stop", "reset", "refresh", "delete"}
}

func vmActionButtonsActions(props VMActionButtonsProps) []string {
	if len(props.Actions) > 0 {
		return props.Actions
	}
	return getDefaultActions()
}

func vmActionStartDisabled(props VMActionButtonsProps) bool {
	return !props.ProxmoxConnected || props.Status == "running"
}

func vmActionRunningRequired(props VMActionButtonsProps) bool {
	return !props.ProxmoxConnected || props.Status != "running"
}

func vmActionDeleteDisabled(props VMActionButtonsProps) bool {
	return !props.ProxmoxConnected
}

templ VMActionButtons(props VMActionButtonsProps, T TranslationFunc) {
	<div class={ "buttons", props.ExtraClasses } style="gap: 0.5rem;">
		for _, action := range vmActionButtonsActions(props) {
			if action == "start" {
				@vmActionStartButton(props, T)
			}
			if action == "console" {
				@vmActionConsoleButton(props, T)
			}
			if action == "reboot" {
				@vmActionRebootButton(props, T)
			}
			if action == "shutdown" {
				@vmActionShutdownButton(props, T)
			}
			if action == "stop" {
				@vmActionStopButton(props, T)
			}
			if action == "reset" {
				@vmActionResetButton(props, T)
			}
			if action == "refresh" {
				@vmActionRefreshButton(props, T)
			}
			if action == "delete" {
				@vmActionDeleteButton(props, T)
			}
		}
	</div>
}

templ vmActionStartButton(props VMActionButtonsProps, T TranslationFunc) {
	<form action="/vm/action" method="post" class="is-inline vm-action-form" data-action="start">
		<input type="hidden" name="csrf_token" value={ props.CSRFToken }/>
		<input type="hidden" name="vmid" value={ strconv.Itoa(props.VMID) }/>
		<input type="hidden" name="node" value={ props.Node }/>
		<input type="hidden" name="action" value="start"/>
		<button type="submit" class="button is-success has-text-white vm-action-button" disabled?={ vmActionStartDisabled(props) }>
			<span class="icon"><i class="fas fa-play"></i></span>
			<span class="button-text">{ T("VMDetails.Action.Start") }</span>
			<span class="button-loading is-hidden">
				<i class="fas fa-spinner fa-spin"></i>
			</span>
		</button>
	</form>
}

templ vmActionConsoleButton(props VMActionButtonsProps, T TranslationFunc) {
	<button id="console-button" class="button is-primary vm-console-button" disabled?={ vmActionRunningRequired(props) }>
		<span class="icon"><i class="fas fa-terminal"></i></span>
		<span class="button-text">{ T("VMDetails.Action.Console") }</span>
		<span class="button-loading is-hidden">
			<i class="fas fa-spinner fa-spin"></i>
		</span>
	</button>
}

