package components

type LoginData struct {
	Warning     string
	Error       string
	CSRFToken   string
	ReturnURL   string
	RedirectURL string
	Lang        string
	IsAdmin     bool
}

templ LoginPage(data LoginData, T TranslationFunc) {
	@Layout(LayoutProps{
		Title:            T("Login.UserLogin"),
		Lang:             data.Lang,
		CurrentPath:      "/login",
		Content:          loginContent(data, T),
		IsAuthenticated:  false,
		IsAdmin:          data.IsAdmin,
		Username:         "",
		ProxmoxConnected: false,
		CSRFToken:        data.CSRFToken,
		T:                T,
	})
}

templ loginContent(data LoginData, T TranslationFunc) {
	<section class="section min-h-100vh flex-center" style="padding: 2rem 1rem;">
		<div class="container">
			<div class="columns is-centered">
				<div class="column is-10-mobile is-8-tablet is-6-desktop is-5-widescreen">
					<div class="card admin-card login-card">
						<header class="card-header brand-header is-align-items-center login-header">
							<p class="card-header-title login-title">
								if data.IsAdmin {
									{ T("AdminLogin.Title") }
								} else {
									{ T("Login.UserLogin") }
								}
							</p>
						</header>
						<div class="card-content login-content p-6">
							if data.Warning != "" {
								@Notification(NotificationProps{
									Type:        NotificationInfo,
									Title:       T("Common.Information"),
									Message:     data.Warning,
									Icon:        "fas fa-info-circle",
									Dismissible: true,
								})
							}
							if data.Error != "" {
								@Notification(NotificationProps{
									Type:        NotificationDanger,
									Title:       T("Common.Error"),
									Message:     data.Error,
									Icon:        "fas fa-exclamation-triangle",
									Dismissible: true,
								})
							}
							if data.IsAdmin {
								@adminLoginForm(data, T)
							} else {
								@userLoginForm(data, T)
							}
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>
}

templ userLoginForm(data LoginData, T TranslationFunc) {
	<form method="post" action="/login" novalidate>
		<input type="hidden" name="csrf_token" value={ data.CSRFToken }/>
		<input type="hidden" name="login_type" value="user"/>
		if data.ReturnURL != "" {
			<input type="hidden" name="return" value={ data.ReturnURL }/>
		}
		if data.RedirectURL != "" {
			<input type="hidden" name="redirect" value={ data.RedirectURL }/>
		}
		<div class="field">
			<label class="form-label" for="username">
				<span class="form-label-icon">
					<span class="icon"><i class="fas fa-user"></i></span>
				</span>
				<span class="form-label-text">{ T("Login.UsernameLabel") }</span>
			</label>
			<div class="control">
				<input
					class="input is-large input-lg"
					type="text"
					id="username"
					name="username"
					required
					autofocus
					autocomplete="username"
					aria-required="true"
					aria-describedby="username-help"
					minlength="3"
					maxlength="50"
					pattern="[a-zA-Z0-9_\-]+"
					placeholder={ T("Login.UsernameLabel") }
				/>
			</div>
		</div>
		<div class="field">
			<label class="form-label" for="password">
				<span class="form-label-icon">
					<span class="icon"><i class="fas fa-lock"></i></span>
				</span>
				<span class="form-label-text">{ T("Login.PasswordLabel") }</span>
			</label>
			<div class="control">
				<input
					class="input is-large input-lg"
					type="password"
					id="password"
					name="password"
					required
					autocomplete="current-password"
					aria-required="true"
					aria-describedby="password-help"
					minlength="6"
					maxlength="128"
					placeholder={ T("Login.PasswordLabel") }
				/>
			</div>
		</div>
		<div class="field mt-5">
			<div class="control">
				<button class="button is-primary is-fullwidth is-large login-button" type="submit" aria-label={ T("Login.Button") }>
					<span class="icon is-medium" aria-hidden="true">
						<i class="fas fa-sign-in-alt"></i>
					</span>
					<span>{ T("Login.Button") }</span>
				</button>
			</div>
		</div>
	</form>
	<div class="has-text-centered divider-with-text">
		<hr/>
		<span></span>
	</div>
	<div class="has-text-centered">
		<a class="button is-light is-fullwidth login-alt-button" href="/admin/login">
			<span class="icon has-text-primary">
				<i class="fas fa-shield-alt"></i>
			</span>
			<span>{ T("Login.AdminLoginLink") }</span>
		</a>
	</div>
}

templ adminLoginForm(data LoginData, T TranslationFunc) {
	<div x-data="adminLoginTabs()">
		<div class="tabs is-centered is-boxed mb-5">
			<ul>
				<li :class="{ 'is-active': activeTab === 'local' }">
					<a @click.prevent="setTab('local')" href="#" role="button">
						<span class="icon is-small"><i class="fas fa-shield-alt"></i></span>
						<span>{ T("AdminLogin.LocalAdminTab") }</span>
					</a>
				</li>
				<li :class="{ 'is-active': activeTab === 'pve' }">
					<a @click.prevent="setTab('pve')" href="#" role="button">
						<span class="icon is-small"><i class="fas fa-server"></i></span>
						<span>{ T("AdminLogin.ProxmoxAdminTab") }</span>
					</a>
				</li>
			</ul>
		</div>
		<div id="local-admin-form" class="tab-content" x-show="activeTab === 'local'" x-transition>
		<form method="post" action="/admin/login" novalidate>
			<input type="hidden" name="csrf_token" value={ data.CSRFToken }/>
			<input type="hidden" name="login_type" value="admin"/>
			if data.ReturnURL != "" {
				<input type="hidden" name="return" value={ data.ReturnURL }/>
			}
			if data.RedirectURL != "" {
				<input type="hidden" name="redirect" value={ data.RedirectURL }/>
			}
			<div class="field">
				<label class="form-label" for="password">
					<span class="form-label-icon">
						<span class="icon"><i class="fas fa-lock"></i></span>
					</span>
					<span class="form-label-text">{ T("AdminLogin.PasswordLabel") }</span>
				</label>
				<div class="control">
					<input
						class="input is-large input-lg"
						type="password"
						id="password"
						name="password"
						required
						autofocus
						autocomplete="current-password"
						aria-required="true"
						aria-describedby="password-help"
						minlength="6"
						maxlength="128"
						placeholder={ T("AdminLogin.PasswordLabel") }
					/>
				</div>
			</div>
			<div class="field mt-5">
				<div class="control">
					<button class="button is-primary is-fullwidth is-large login-button" type="submit" aria-label={ T("Login.Button") }>
						<span class="icon is-medium" aria-hidden="true">
							<i class="fas fa-sign-in-alt"></i>
						</span>
						<span>{ T("Login.Button") }</span>
					</button>
				</div>
			</div>
		</form>
	</div>
	<div id="pve-admin-form" class="tab-content" x-show="activeTab === 'pve'" x-cloak x-transition>
		<form method="post" action="/admin/proxmox-login" novalidate @submit="validatePveForm($event)">
			<input type="hidden" name="csrf_token" value={ data.CSRFToken }/>
			<input type="hidden" name="login_type" value="admin"/>
			if data.ReturnURL != "" {
				<input type="hidden" name="return" value={ data.ReturnURL }/>
			}
			if data.RedirectURL != "" {
				<input type="hidden" name="redirect" value={ data.RedirectURL }/>
			}
			<div class="field">
				<label class="form-label" for="pve-username">
					<span class="form-label-icon">
						<span class="icon"><i class="fas fa-user"></i></span>
					</span>
					<span class="form-label-text">{ T("Login.UsernameLabel") }</span>
				</label>
				<div class="control">
					<input
						class="input is-large input-lg"
						type="text"
						id="pve-username"
						name="username"
						required
						autocomplete="username"
						aria-required="true"
						aria-describedby="pve-username-help"
						minlength="3"
						maxlength="50"
						pattern="[a-zA-Z0-9_\-@]+"
						placeholder={ T("Login.UsernameLabel") }
						@blur="addRealmIfMissing($event)"
					/>
				</div>
			</div>
			<div class="field">
				<label class="form-label" for="pve-password">
					<span class="form-label-icon">
						<span class="icon"><i class="fas fa-lock"></i></span>
					</span>
					<span class="form-label-text">{ T("Login.PasswordLabel") }</span>
				</label>
				<div class="control">
					<input
						class="input is-large input-lg"
						type="password"
						id="pve-password"
						name="password"
						required
						autocomplete="current-password"
						aria-required="true"
						aria-describedby="pve-password-help"
						minlength="6"
						maxlength="128"
						placeholder={ T("Login.PasswordLabel") }
					/>
				</div>
			</div>
			<div class="field mt-5">
				<div class="control">
					<button class="button is-primary is-fullwidth is-large login-button" type="submit" aria-label={ T("Login.Button") }>
						<span class="icon is-medium" aria-hidden="true">
							<i class="fas fa-sign-in-alt"></i>
						</span>
						<span>{ T("Login.Button") }</span>
					</button>
				</div>
			</div>
		</form>
	</div>
	<div class="has-text-centered divider-with-text mt-5">
			<hr/>
			<span></span>
		</div>
		<div class="has-text-centered">
			<a class="button is-light is-fullwidth login-alt-button" href="/login">
				<span class="icon has-text-primary">
					<i class="fas fa-user"></i>
				</span>
				<span>{ T("Login.UserLogin") }</span>
			</a>
		</div>
	</div>
}
