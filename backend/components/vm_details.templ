package components

import (
	"fmt"
	"strconv"
)

type DiskInfo struct {
	Index     string
	Bus       string
	Storage   string
	Raw       string
	SizeGB    int
	SizeLabel string
	Color     string
}

type NetworkInterface struct {
	Index       string
	Bridge      string
	Model       string
	ModelLabel  string
	MACAddress  string
	VLAN        string
	Rate        string
	MTU         string
	LinkDown    bool
	IPAddresses []string
}

type CloudInitData struct {
	User         string
	IPConfig     string
	Nameserver   string
	Cicustom     string
	TemplateName string
	TemplateYAML string
	SSHKeys      string
}

type SnapshotInfo struct {
	Name        string
	Description string
	Snaptime    int64
	Vmstate     int
	Parent      string
}

type VMInfo struct {
	VMID   int
	Name   string
	Node   string
	Status string
	CPU    float64
	CPUs   int
	Mem    int64
	MaxMem int64
}

type VMDetailsData struct {
	VM                    VMInfo
	Lang                  string
	CSRFToken             string
	ProxmoxConnected      bool
	IsAdmin               bool
	Username              string
	Success               bool
	SuccessMessage        string
	Error                 bool
	ErrorMessage          string
	Warning               bool
	WarningMessage        string
	IsNewlyCreated        bool
	Description           string
	DescriptionHTML       string
	Tags                  string
	Disks                 []DiskInfo
	DisksTotalLabel       string
	NetworkInterfaces     []NetworkInterface
	CurrentISO            string
	EFIEnabled            bool
	EFIStorage            string
	TPMEnabled            bool
	CloudInitEnabled      bool
	CloudInitData         CloudInitData
	Snapshots             []SnapshotInfo
	CurrentSnapshotName   string
	MaxSnapshots          int
	FormattedMemGB        string
	FormattedMaxMemGB     string
	ShowDescriptionEditor bool
	ShowTagsEditor        bool
	ShowResourcesEditor   bool
	AvailableTags         []string
	Bridges               []string
	BridgeNodes           map[string]string
	BridgeDescriptions    map[string]string
	Storages              []string
	StorageNodes          map[string]string
	ISOs                  []string
	VMSocketsMin          int
	VMSocketsMax          int
	VMCoresMin            int
	VMCoresMax            int
	VMRamMinMB            int
	VMRamMaxMB            int
	VMDiskMin             int
	VMDiskMax             int
	CurrentBridge         string
	CurrentNetworkModel   string
}

templ VMDetailsPage(data VMDetailsData, T TranslationFunc) {
	@Layout(LayoutProps{
		Title:            fmt.Sprintf("%s (%d)", data.VM.Name, data.VM.VMID),
		Lang:             data.Lang,
		CurrentPath:      fmt.Sprintf("/vm/details/%d", data.VM.VMID),
		IsAuthenticated:  true,
		IsAdmin:          data.IsAdmin,
		Username:         data.Username,
		ProxmoxConnected: data.ProxmoxConnected,
		CSRFToken:        data.CSRFToken,
		Content:          vmDetailsContent(data, T),
		T:                T,
	})
}

templ vmDetailsContent(data VMDetailsData, T TranslationFunc) {
	@vmDetailsConfigDiv(data, T)
	<section class="section">
		<div class="container" style="max-width: 1200px;">
			@vmDetailsNotifications(data, T)
			@vmDetailsNavLinks(T)
			if data.IsNewlyCreated {
				@vmDetailsCelebrationBanner(data, T)
			}
			@vmDetailsOverviewCard(data, T)
			@vmDetailsDescriptionTagsGrid(data, T)
			if data.ShowDescriptionEditor {
				@vmDetailsDescriptionEditor(data, T)
			}
			if data.ShowTagsEditor {
				@vmDetailsTagsEditor(data, T)
			}
			if data.ShowResourcesEditor {
				@vmDetailsResourcesEditor(data, T)
			}
			@vmDetailsSnapshotsCard(data, T)
		</div>
	</section>
	@vmDetailsConsoleModal(data, T)
	@vmDetailsScripts(data, T)
}

func vmStatusClass(status string) string {
	switch status {
	case "running":
		return "is-success"
	case "stopped":
		return "is-danger"
	case "paused":
		return "is-warning"
	default:
		return "is-light"
	}
}

func vmStatusLabel(status string, T TranslationFunc) string {
	switch status {
	case "running":
		return T("Status.Running")
	case "stopped":
		return T("Status.Stopped")
	case "paused":
		return T("Status.Paused")
	default:
		return status
	}
}

func vmDetailsRAMPercent(data VMDetailsData) string {
	if data.VM.MaxMem == 0 {
		return "0"
	}
	percent := float64(data.VM.Mem) / float64(data.VM.MaxMem) * 100
	return fmt.Sprintf("%.0f", percent)
}

func vmDetailsDiskItemStyle(idx int, total int) string {
	marginBottom := "0.75rem"
	if idx == total-1 {
		marginBottom = "0"
	}
	return fmt.Sprintf("background: white; border: 1px solid #e2e8f0; border-radius: 8px; padding: 1rem; margin-bottom: %s; transition: all 0.15s ease;", marginBottom)
}

func vmDetailsNetworkColumnClass(ifaceCount int) string {
	if ifaceCount == 1 {
		return "is-one-third-tablet is-half-mobile"
	}
	return "is-full-tablet"
}

func vmDetailsNetworkItemStyle(idx int, total int) string {
	marginBottom := "0.75rem"
	if idx == total-1 {
		marginBottom = "0"
	}
	return fmt.Sprintf("background: white; border: 1px solid #e2e8f0; border-radius: 8px; padding: 1rem; margin-bottom: %s; transition: all 0.15s ease;", marginBottom)
}

func vmDetailsDescColumnClass(tags string) string {
	if tags != "" {
		return "is-7"
	}
	return "is-12"
}

func vmDetailsSplitTags(tags string) []string {
	if tags == "" {
		return nil
	}
	result := []string{}
	for _, tag := range splitString(tags, ", ") {
		if tag != "" {
			result = append(result, tag)
		}
	}
	return result
}

func splitString(s string, sep string) []string {
	if s == "" {
		return nil
	}
	result := []string{}
	start := 0
	for i := 0; i <= len(s)-len(sep); i++ {
		if s[i:i+len(sep)] == sep {
			result = append(result, s[start:i])
			start = i + len(sep)
			i += len(sep) - 1
		}
	}
	result = append(result, s[start:])
	return result
}

func vmDetailsTagSelected(currentTags string, tag string) bool {
	for _, t := range vmDetailsSplitTags(currentTags) {
		if t == tag {
			return true
		}
	}
	return false
}

templ vmDetailsStatusBadge(status string, T TranslationFunc) {
	<span class={ "tag", vmStatusClass(status) } id="vm-status-badge">
		{ vmStatusLabel(status, T) }
	</span>
}

templ vmDetailsConfigDiv(data VMDetailsData, T TranslationFunc) {
	<div
		id="vm-details-config"
		class="is-hidden"
		aria-hidden="true"
		data-processing-label={ T("Common.Processing") }
		data-msg-network-enabled={ T("Message.NetworkCardEnabled") }
		data-msg-network-disabled={ T("Message.NetworkCardDisabled") }
		data-msg-action-failed={ T("Message.ActionFailed") }
		data-error-message={ data.ErrorMessage }
		data-success-message={ data.SuccessMessage }
		data-warning-message={ data.WarningMessage }
		data-label-enabled={ T("Common.Enabled") }
		data-label-disabled={ T("Common.Disabled") }
		data-label-enable={ T("Common.Enable") }
		data-label-disable={ T("Common.Disable") }
		data-network-label={ T("VM.Create.Network") }
		data-console-must-be-running={ T("VMDetails.Console.MustBeRunning") }
		data-console-unavailable={ T("VMDetails.Console.TemporarilyUnavailable") }
		data-console-not-found={ T("VMDetails.Console.ButtonNotFound") }
		data-vmid={ strconv.Itoa(data.VM.VMID) }
		data-node={ data.VM.Node }
	></div>
}

templ vmDetailsNotifications(data VMDetailsData, T TranslationFunc) {
	if data.Success {
		@Notification(NotificationProps{
			Type:        NotificationSuccess,
			Message:     data.SuccessMessage,
			Icon:        "fas fa-check",
			Dismissible: true,
		})
	}
	if data.Error {
		@Notification(NotificationProps{
			Type:        NotificationDanger,
			Message:     data.ErrorMessage,
			Icon:        "fas fa-exclamation-triangle",
			Dismissible: true,
		})
	}
	if data.Warning {
		@Notification(NotificationProps{
			Type:        NotificationWarning,
			Message:     data.WarningMessage,
			Icon:        "fas fa-exclamation-triangle",
			Dismissible: true,
		})
	}
}

templ vmDetailsNavLinks(T TranslationFunc) {
	<div class="level mb-4">
		<div class="level-left"></div>
		<div class="level-right">
			<div class="level-item">
				@ButtonGroup(ButtonGroupProps{
					Buttons: []templ.Component{
						Button(ButtonProps{
							Text: T("Navbar.Profile"),
							Icon: "fas fa-user",
							Href: "/profile",
							Type: ButtonPrimary,
						}),
						Button(ButtonProps{
							Text: T("Common.Search"),
							Icon: "fas fa-search",
							Href: "/search",
							Type: ButtonPrimary,
						}),
					},
				})
			</div>
		</div>
	</div>
}
