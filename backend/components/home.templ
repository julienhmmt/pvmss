package components

type HomeData struct {
	Username         string
	Lang             string
	CSRFToken        string
	IsAdmin          bool
	IsAuthenticated  bool
	ProxmoxConnected bool
}

templ HomePage(data HomeData, T TranslationFunc) {
	@Layout(LayoutProps{
		Title:            T("UI.Header"),
		Lang:             data.Lang,
		CurrentPath:      "/",
		IsAuthenticated:  data.IsAuthenticated,
		IsAdmin:          data.IsAdmin,
		Username:         data.Username,
		ProxmoxConnected: data.ProxmoxConnected,
		CSRFToken:        data.CSRFToken,
		T:                T,
		Content:          homeContent(data, T),
	})
}

templ homeContent(data HomeData, T TranslationFunc) {
	<section class="section">
		<div class="container">
			<div class="hero is-primary is-small">
				<div class="hero-body">
					<div class="container has-text-centered">
						<h1 class="title is-2 has-text-white mb-2">
							{ T("UI.Header") }
						</h1>
						<p class="subtitle has-text-white mb-2">
							{ T("UI.Subtitle") }
						</p>
						<p class="subtitle has-text-white is-size-5">
							{ T("UI.Body") }
						</p>
					</div>
				</div>
			</div>
			<div class="columns is-centered">
				<div class="column is-10 welcome-block">
					<div class="columns is-multiline is-centered">
						<div class="column is-4-desktop is-6-tablet">
							<div class="card">
								<div class="card-header brand-header">
									<p class="card-header-title has-text-centered">
										<span class="icon-text">
											<span class="icon">
												<i class="fas fa-plus-square"></i>
											</span>
											<span>{ T("Navbar.CreateVM") }</span>
										</span>
									</p>
								</div>
								<div class="card-content has-text-centered">
									<p class="mb-4">{ T("UI.CreateVMDescription") }</p>
									@Button(ButtonProps{
										Text:        T("UI.GetStarted"),
										Href:        "/vm/create",
										Type:        ButtonPrimary,
										Size:        ButtonMedium,
										IsFullwidth: true,
									})
								</div>
							</div>
						</div>
						<div class="column is-4-desktop is-6-tablet">
							<div class="card">
								<div class="card-header brand-header">
									<p class="card-header-title has-text-centered">
										<span class="icon-text">
											<span class="icon">
												<i class="fas fa-book"></i>
											</span>
											<span>{ T("Docs.User.Title") }</span>
										</span>
									</p>
								</div>
								<div class="card-content has-text-centered">
									<p class="mb-4">{ T("UI.DocsDescription") }</p>
									<a href="/docs/user" class="button is-primary is-medium is-fullwidth">
										{ T("UI.ViewDocumentation") }
									</a>
								</div>
							</div>
						</div>
						<div class="column is-4-desktop is-6-tablet">
							<div class="card">
								<div class="card-header brand-header">
									<p class="card-header-title has-text-centered">
										<span class="icon-text">
											<span class="icon">
												<i class="fas fa-screwdriver-wrench"></i>
											</span>
											<span>{ T("Navbar.Admin") }</span>
										</span>
									</p>
								</div>
								<div class="card-content has-text-centered">
									<p class="mb-4">{ T("UI.AdminDescription") }</p>
							@Button(ButtonProps{
								Text:        T("UI.AccessAdmin"),
								Href:        "/admin/nodes",
								Type:        ButtonPrimary,
								Size:        ButtonMedium,
								IsFullwidth: true,
							})
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>
}
