package components

import "fmt"

type NavbarProps struct {
	CurrentPath      string
	IsAuthenticated  bool
	IsAdmin          bool
	Username         string
	ProxmoxConnected bool
	Lang             string
}

templ Navbar(props NavbarProps, T TranslationFunc) {
	<input type="checkbox" id="nav-toggle" class="nav-toggle-checkbox" hidden/>
	<nav class="navbar is-fixed-top" role="navigation" aria-label="main navigation">
		<div class="container">
			<div class="navbar-brand">
				<a class="navbar-item" href="/">
					{ T("UI.Header") }
				</a>
				<label class="navbar-burger" for="nav-toggle" aria-label="menu" aria-expanded="false">
					<span aria-hidden="true"></span>
					<span aria-hidden="true"></span>
					<span aria-hidden="true"></span>
				</label>
			</div>
			<div class="navbar-menu" id="navbarMenuDesktop">
				<div class="navbar-menu-header">
					<span class="navbar-menu-title">{ T("UI.Header") }</span>
					<button class="navbar-menu-close" aria-label="Close menu">
						<span aria-hidden="true">&times;</span>
					</button>
				</div>
				<div class="navbar-start">
					@navbarItems(props, T)
				</div>
				<div class="navbar-end">
					@navbarActions(props, T)
				</div>
			</div>
		</div>
	</nav>
	<div id="navbar-menu" class="navbar-menu-mobile">
		<div class="navbar-menu-mobile-header">
			<span class="navbar-menu-mobile-title">{ T("UI.Header") }</span>
			<label class="navbar-menu-mobile-close" for="nav-toggle" aria-label="Close menu">
				<span aria-hidden="true">&times;</span>
			</label>
		</div>
		<div class="navbar-start">
			@navbarItems(props, T)
		</div>
		<div class="navbar-end">
			@navbarActions(props, T)
		</div>
	</div>
	<label for="nav-toggle" class="navbar-backdrop"></label>
}

templ navbarItems(props NavbarProps, T TranslationFunc) {
	<a
		class={ "navbar-item", templ.KV("is-active", props.CurrentPath == "/") }
		href="/"
		if props.CurrentPath == "/" {
			aria-current="page"
		}
	>
		<span class="icon-text">
			<span class="icon"><i class="fas fa-home"></i></span>
			<span>{ T("Navbar.Home") }</span>
		</span>
	</a>
	<a
		class={ "navbar-item", templ.KV("is-active", props.CurrentPath == "/vm/create"), templ.KV("is-disabled", !props.IsAuthenticated || !props.ProxmoxConnected) }
		href="/vm/create"
		if props.CurrentPath == "/vm/create" {
			aria-current="page"
		}
		if !props.IsAuthenticated || !props.ProxmoxConnected {
			aria-disabled="true"
			tabindex="-1"
			if !props.IsAuthenticated {
				title="Login required"
			} else {
				title="Proxmox server unavailable"
			}
		}
	>
		<span class="icon-text">
			<span class="icon"><i class="fas fa-plus-square"></i></span>
			<span>{ T("Navbar.CreateVM") }</span>
			if !props.ProxmoxConnected {
				<span class="icon has-text-danger ml-1"><i class="fas fa-exclamation-triangle"></i></span>
			}
		</span>
	</a>
	<a
		class={ "navbar-item", templ.KV("is-active", props.CurrentPath == "/search"), templ.KV("is-disabled", !props.IsAuthenticated || !props.ProxmoxConnected) }
		href="/search"
		if props.CurrentPath == "/search" {
			aria-current="page"
		}
		if !props.IsAuthenticated || !props.ProxmoxConnected {
			aria-disabled="true"
			tabindex="-1"
			if !props.IsAuthenticated {
				title="Login required"
			} else {
				title="Proxmox server unavailable"
			}
		}
	>
		<span class="icon-text">
			<span class="icon"><i class="fas fa-search"></i></span>
			<span>{ T("Navbar.SearchVM") }</span>
			if !props.ProxmoxConnected {
				<span class="icon has-text-danger ml-1"><i class="fas fa-exclamation-triangle"></i></span>
			}
		</span>
	</a>
	<a
		class={ "navbar-item", templ.KV("is-active", props.CurrentPath == "/docs/user" || props.CurrentPath == "/docs/admin") }
		href="/docs/user"
		if props.CurrentPath == "/docs/user" || props.CurrentPath == "/docs/admin" {
			aria-current="page"
		}
	>
		<span class="icon-text">
			<span class="icon"><i class="fas fa-book"></i></span>
			<span>{ T("Navbar.Documentation") }</span>
		</span>
	</a>
}

templ navbarActions(props NavbarProps, T TranslationFunc) {
	<div class="navbar-item navbar-actions">
		<div class="buttons has-addons language-buttons">
			<a
				href="/set-lang?lang=fr"
				class={ "button", templ.KV("is-selected", props.Lang == "fr") }
				title="Français"
			>FR</a>
			<a
				href="/set-lang?lang=en"
				class={ "button", templ.KV("is-selected", props.Lang == "en") }
				title="English"
			>EN</a>
		</div>
		if props.IsAuthenticated {
			<div
				class="navbar-user-menu"
				data-vue-component="nav-user-menu"
				data-username={ props.Username }
				data-is-admin={ fmt.Sprintf("%t", props.IsAdmin) }
				data-label-admin={ T("Navbar.Admin") }
				data-label-profile={ T("Navbar.Profile") }
				data-label-logout={ T("Navbar.Logout") }
			></div>
		} else {
			<a class="button is-primary navbar-login-btn" href="/login" title={ T("Navbar.Login") }>
				<span class="icon"><i class="fas fa-sign-in-alt"></i></span>
				<span class="navbar-login-text">{ T("Navbar.Login") }</span>
			</a>
		}
	</div>
}
